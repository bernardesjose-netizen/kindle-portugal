---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import ArtigoLayout from '@layouts/ArtigoLayout.astro';

export async function getStaticPaths() {
  const guias = await getCollection('guias', ({ data }) => !data.rascunho);
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);
const d = guia.data;
const capa = d.mostrar_imagem_hero ? d.imagem_hero : undefined;
---

<ArtigoLayout
  titulo={d.titulo}
  descricao={d.descricao}
  tituloSeo={d.seo?.titulo_seo}
  descricaoSeo={d.seo?.descricao_seo}
  noindex={d.seo?.noindex}
  autor={d.autor}
  dataPublicacao={d.data_publicacao}
  dataRevisao={d.data_revisao}
  categoria={d.categoria}
  tempoLeituraMin={d.tempo_leitura_min}
  imagem={d.seo?.imagem_partilha ?? capa?.src}
  imagemAlt={d.seo?.imagem_partilha ? d.imagem_hero_alt : undefined}
>
  {capa && (
    <figure class="not-prose mb-10 overflow-hidden rounded-2xl border border-marinho-100">
      <Image
        src={capa}
        alt={d.imagem_hero_alt ?? d.titulo}
        class="block h-auto w-full"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  )}
  <Content />
</ArtigoLayout>
