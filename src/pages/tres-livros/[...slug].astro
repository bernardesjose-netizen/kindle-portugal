---
import { getCollection, render } from 'astro:content';
import ArtigoLayout from '@layouts/ArtigoLayout.astro';
import CardLivro from '@components/CardLivro.astro';
import { urlCapaLivro } from '@lib/capa-livro';

export async function getStaticPaths() {
  const posts = await getCollection('tresLivros', ({ data }) => !data.rascunho);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

// Hero: capa do primeiro livro do post.
// Construímos o URL aqui em vez de usar `heroAsin` (que o ArtigoLayout
// resolve via imagemParaAsin, função que só conhece dispositivos Kindle).
const heroSrc = urlCapaLivro(d.livros[0].asin, 'grande', d.livros[0].capa_amazon);
const convidado = d.convidado_ingles;
---

<ArtigoLayout
  titulo={d.titulo}
  descricao={d.descricao}
  tituloSeo={d.seo?.titulo_seo}
  descricaoSeo={d.seo?.descricao_seo}
  noindex={d.seo?.noindex}
  autor={d.autor}
  dataPublicacao={d.data_publicacao}
  categoria="Três Ebooks"
  imagem={heroSrc}
>
  <Content />

  <section aria-label="Os três livros desta edição" class="not-prose">
    {d.livros.map((livro, i) => (
      <CardLivro
        asin={livro.asin}
        titulo={livro.titulo}
        autor={livro.autor}
        editora={livro.editora}
        ano={livro.ano}
        marketplace={livro.marketplace}
        comentario={livro.comentario}
        urlWook={livro.url_wook}
        fonteEdicao={livro.fonte_edicao}
        capaAmazon={livro.capa_amazon}
        numero={i + 1}
      />
    ))}
  </section>

  {convidado && (
    <section aria-labelledby="titulo-convidado-ingles" class="not-prose mt-12 rounded-2xl border border-oceano-100 bg-oceano-50/70 px-4 py-6 sm:px-7">
      <h2 id="titulo-convidado-ingles" class="text-2xl font-bold text-marinho-900">Uma leitura em inglês</h2>
      <p class="mt-2 max-w-prose text-marinho-700">De seis em seis dias, juntamos um best-seller em inglês às três escolhas portuguesas.</p>
      <CardLivro
        asin={convidado.asin}
        titulo={convidado.titulo}
        autor={convidado.autor}
        editora={convidado.editora}
        ano={convidado.ano}
        marketplace={convidado.marketplace}
        comentario={convidado.comentario}
        fonteEdicao={convidado.fonte_edicao}
        capaAmazon={convidado.capa_amazon}
      />
    </section>
  )}
</ArtigoLayout>
