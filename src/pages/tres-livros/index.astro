---
import { temImagemAmazonApi } from '@lib/amazon-imagens-api';
import LigacaoCapaLivro from '@components/afiliados/LigacaoCapaLivro.astro';
import DestaqueBlackWook from '@components/afiliados/DestaqueBlackWook.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { formatarData } from '@lib/formatters';
import { urlCapaLivro } from '@lib/capa-livro';

const edicoes = await getCollection('tresLivros');
const posts = edicoes.filter((p) => !p.data.rascunho).sort(
  (a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf(),
);
const ultimaPortugues = posts.find((p) => p.data.serie === 'portugues');
const ultimaIngles = posts.find((p) => p.data.serie === 'ingles');
---

<BaseLayout
  titulo="Três Ebooks"
  descricao="Descobre três ebooks em português de Portugal de dois em dois dias e três em inglês de três em três dias, com notas de leitura e ligações para as edições Kindle."
>
  <section class="relative overflow-hidden border-b-4 border-dourado-500 bg-gradient-to-br from-marinho-900 via-oceano-800 to-marinho-800 text-creme-50">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(ellipse at top right, rgb(212 168 75 / 0.30) 0%, transparent 55%), radial-gradient(ellipse at bottom left, rgb(20 110 180 / 0.35) 0%, transparent 50%);"
    />
    <Container largura="normal" classe="relative z-10 py-14">
      <div class="max-w-3xl">
        <div>
          <h1 class="mt-3 text-3xl font-bold text-creme-50 md:text-4xl" style="font-family: var(--font-serif);">
            Três Ebooks
          </h1>
          <p class="mt-3 max-w-2xl text-oceano-100/90">
            De dois em dois dias, escolhemos três ebooks em português de Portugal. De três em três dias, há outra seleção com três livros em inglês. Cada nota de leitura acompanha a edição indicada.
          </p>
          <nav aria-label="Séries da rubrica" class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-creme-50">
            {ultimaPortugues && <a href="#em-portugues" class="underline decoration-dourado-400 underline-offset-4">Última seleção em português</a>}
            {ultimaIngles && <a href="#em-ingles" class="underline decoration-dourado-400 underline-offset-4">Última seleção em inglês</a>}
          </nav>
        </div>
      </div>
    </Container>
  </section>

  <Container largura="normal" classe="py-14">
    <DestaqueBlackWook />
    {posts.length === 0 ? (
      <p class="text-marinho-600">Ainda não há edições publicadas nesta rubrica.</p>
    ) : (
      <ul id="arquivo" aria-label="Todas as edições" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => {
          const temCapaComLigacao = p.data.livros.some(temImagemAmazonApi);
          const Cartao = temCapaComLigacao ? 'div' : 'a';
          const Titulo = temCapaComLigacao ? 'a' : 'span';
          const destino = `/tres-livros/${p.id}`;
          return (
            <li id={p === ultimaIngles ? 'em-ingles' : p === ultimaPortugues ? 'em-portugues' : undefined} class="group scroll-mt-20">
              <Cartao href={temCapaComLigacao ? undefined : destino} class="block">
                <div class="relative mb-4 grid grid-cols-3 gap-2 rounded-xl bg-gradient-to-br from-marinho-50 to-creme-100 p-4 transition-transform group-hover:-translate-y-1">
                  {p.data.livros.map((livro) => (
                    <LigacaoCapaLivro asin={livro.asin}>
                      <img
                        src={urlCapaLivro(livro.asin, 'pequeno', livro.capa_amazon)}
                        alt={`Capa do livro (${livro.titulo})`}
                        loading="lazy"
                        decoding="async"
                        width="200"
                        height="300"
                        class="h-auto w-full object-contain"
                        style="filter: drop-shadow(0 4px 8px rgba(15,26,36,0.18));"
                        referrerpolicy="strict-origin-when-cross-origin"
                        data-fallback={livro.capa_amazon && livro.asin ? urlCapaLivro(livro.asin) : undefined}
                      />
                    </LigacaoCapaLivro>
                  ))}
                </div>
                <h2 class="text-lg font-semibold leading-snug text-marinho-900 group-hover:text-marca-700">
                  <Titulo href={temCapaComLigacao ? destino : undefined}>{p.data.titulo}</Titulo>
                </h2>
                <p class="mt-2 text-sm text-marinho-600">{p.data.descricao}</p>
                {p.data.ingles && <p class="mt-2 text-xs font-semibold text-oceano-800">Artigo bilingue · <span lang="en">English version included</span></p>}
                {p.data.convidado_ingles && <p class="mt-2 text-xs font-semibold text-oceano-800">Inclui uma leitura em inglês</p>}
                <p class="mt-2 text-xs text-marinho-400">
                  <time datetime={p.data.data_publicacao.toISOString()}>
                    {formatarData(p.data.data_publicacao)}
                  </time> · {p.data.serie === 'ingles' ? 'Livros em inglês' : 'Livros em português'}
                </p>
              </Cartao>
            </li>
          );
        })}
      </ul>
    )}
  </Container>
</BaseLayout>
