---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { formatarData } from '@lib/formatters';
import { urlCapaLivro } from '@lib/capa-livro';

const edicoes = await getCollection('tresLivros');
const posts = edicoes.filter((p) => !p.data.rascunho).sort(
  (a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf(),
);
const portugues = posts.filter((p) => p.data.serie === 'portugues');
const recente = (p: typeof posts[number]) => p.data.tags.some((t) => t === 'originais-pt-pt' || t === 'edicoes-pt-pt');
const primeiraEmIngles = edicoes.filter((p) => p.data.serie === 'ingles').sort(
  (a, b) => a.data.data_publicacao.valueOf() - b.data.data_publicacao.valueOf(),
)[0];
const grupos = [
  { id: 'em-portugues', titulo: 'Livros em português de Portugal', posts: portugues.filter(recente) },
  { id: 'em-ingles', titulo: 'Livros em inglês', posts: posts.filter((p) => p.data.serie === 'ingles') },
  { id: 'arquivo', titulo: 'Arquivo da rubrica', posts: portugues.filter((p) => !recente(p)) },
].filter((grupo) => grupo.posts.length || (grupo.id === 'em-ingles' && primeiraEmIngles));
---

<BaseLayout
  titulo="Três Ebooks"
  descricao="Descobre três ebooks em português de Portugal de dois em dois dias e três em inglês de três em três dias, com notas de leitura e ligações para as edições Kindle."
>
  <section class="relative overflow-hidden border-b-4 border-dourado-500 bg-gradient-to-br from-marinho-900 via-oceano-800 to-marinho-800 text-creme-50">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(ellipse at top right, rgb(212 168 75 / 0.30) 0%, transparent 55%), radial-gradient(ellipse at bottom left, rgb(20 110 180 / 0.35) 0%, transparent 50%);"
    />
    <Container largura="normal" classe="relative z-10 py-14">
      <div class="max-w-3xl">
        <div>
          <h1 class="mt-3 text-3xl font-bold text-creme-50 md:text-4xl" style="font-family: var(--font-serif);">
            Três Ebooks
          </h1>
          <p class="mt-3 max-w-2xl text-oceano-100/90">
            De dois em dois dias, escolhemos três ebooks em português de Portugal. De três em três dias, há outra seleção com três livros em inglês. Cada nota de leitura acompanha a edição indicada.
          </p>
          <nav aria-label="Séries da rubrica" class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-creme-50">
            {grupos.map((grupo) => <a href={`#${grupo.id}`} class="underline decoration-dourado-400 underline-offset-4">{grupo.titulo}</a>)}
          </nav>
        </div>
      </div>
    </Container>
  </section>

  <Container largura="normal" classe="py-14">
    {posts.length === 0 ? (
      <p class="text-marinho-600">Ainda não há edições publicadas nesta rubrica.</p>
    ) : (
      grupos.map((grupo) => (
        <section id={grupo.id} class="mb-12 scroll-mt-20 last:mb-0">
          <h2 class="mb-6 text-2xl font-bold text-marinho-900" style="font-family: var(--font-serif);">{grupo.titulo}</h2>
          {grupo.posts.length === 0 && primeiraEmIngles && <p class="text-marinho-600">A primeira seleção de livros em inglês sai a {formatarData(primeiraEmIngles.data.data_publicacao)}. Podes ler o artigo em português ou em inglês.</p>}
          <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {grupo.posts.map((p) => {
              const capa1 = urlCapaLivro(p.data.livros[0].asin, 'pequeno', p.data.livros[0].capa_amazon);
              const capa2 = urlCapaLivro(p.data.livros[1].asin, 'pequeno', p.data.livros[1].capa_amazon);
              const capa3 = urlCapaLivro(p.data.livros[2].asin, 'pequeno', p.data.livros[2].capa_amazon);
              return (
                <li class="group">
                  <a href={`/tres-livros/${p.id}`} class="block">
                    <div class="relative mb-4 grid grid-cols-3 gap-2 rounded-xl bg-gradient-to-br from-marinho-50 to-creme-100 p-4 transition-transform group-hover:-translate-y-1">
                      {p.data.imagem_hero ? (
                        <Image src={p.data.imagem_hero} alt={p.data.imagem_hero_alt ?? p.data.titulo} width={600} class="col-span-3 h-auto w-full rounded-lg" />
                      ) : <>
                        <img src={capa1} alt={`Capa do livro (${p.data.livros[0].titulo})`} loading="lazy" decoding="async" width="200" height="300" class="h-auto w-full object-contain" style="filter: drop-shadow(0 4px 8px rgba(15,26,36,0.18));" referrerpolicy="strict-origin-when-cross-origin" data-fallback="hide" />
                        <img src={capa2} alt={`Capa do livro (${p.data.livros[1].titulo})`} loading="lazy" decoding="async" width="200" height="300" class="h-auto w-full object-contain" style="filter: drop-shadow(0 4px 8px rgba(15,26,36,0.18));" referrerpolicy="strict-origin-when-cross-origin" data-fallback="hide" />
                        <img src={capa3} alt={`Capa do livro (${p.data.livros[2].titulo})`} loading="lazy" decoding="async" width="200" height="300" class="h-auto w-full object-contain" style="filter: drop-shadow(0 4px 8px rgba(15,26,36,0.18));" referrerpolicy="strict-origin-when-cross-origin" data-fallback="hide" />
                      </>}
                    </div>
                    <h3 class="text-lg font-semibold leading-snug text-marinho-900 group-hover:text-marca-700">
                      {p.data.titulo}
                    </h3>
                    <p class="mt-2 text-sm text-marinho-600">{p.data.descricao}</p>
                    {p.data.ingles && <p class="mt-2 text-xs font-semibold text-oceano-800">Artigo bilingue · <span lang="en">English version included</span></p>}
                    {p.data.convidado_ingles && <p class="mt-2 text-xs font-semibold text-oceano-800">Inclui uma leitura em inglês</p>}
                    <p class="mt-2 text-xs text-marinho-400">
                      <time datetime={p.data.data_publicacao.toISOString()}>
                        {formatarData(p.data.data_publicacao)}
                      </time>
                    </p>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    )}
  </Container>
</BaseLayout>
