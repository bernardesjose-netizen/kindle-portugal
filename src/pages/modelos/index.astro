---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import { getCollection } from 'astro:content';
import CartaoFamiliaKindle from '@components/CartaoFamiliaKindle.astro';
import EscolherKindle from '@components/EscolherKindle.astro';

const ordem: Record<string, number> = { basico: 0, paperwhite: 1, colorsoft: 2, scribe: 3 };
const modelos = (await getCollection('modelos', ({ data }) => !data.rascunho))
  .sort((a, b) => (ordem[a.id] ?? 4) - (ordem[b.id] ?? 4));

const destaques = [
  {
    etiqueta: 'Guias',
    titulo: 'Guias práticos',
    texto: 'Enviar ebooks, converter formatos, escolher a capa certa e resolver problemas, passo a passo.',
    href: '/guias',
    caixa: 'caixa-oceano',
    pill: 'pill-oceano',
  },
  {
    etiqueta: 'Comparação',
    titulo: 'Kindle ou Kobo?',
    texto: 'Onde encontrar ebooks em português europeu para cada leitor.',
    href: '/blog/kindle-ou-kobo-livros-portugues-comparacao-2026',
    caixa: 'caixa-marinho',
    pill: 'pill-marinho',
  },
  {
    etiqueta: 'Ebooks',
    titulo: 'Comprar ebooks para Kobo',
    texto: 'Lojas de ebooks, formatos e empréstimos de bibliotecas. Confirma a compatibilidade com o teu modelo.',
    href: '/guias/comprar-ebooks-para-kobo-portugal',
    caixa: 'caixa-dourado',
    pill: 'pill-dourado',
  },
  {
    etiqueta: 'De dois em dois dias',
    titulo: 'Três Ebooks',
    texto: 'Três ebooks escritos em português de Portugal e publicados por editoras portuguesas.',
    href: '/tres-livros',
    caixa: 'caixa-salvia',
    pill: 'pill-salvia',
  },
  {
    etiqueta: 'FAQ',
    titulo: 'Perguntas frequentes',
    texto: 'Respostas diretas às dúvidas mais comuns sobre Kindle e ebooks em Portugal.',
    href: '/faq',
    caixa: 'caixa-marca',
    pill: 'pill',
  },
  {
    etiqueta: 'Blog',
    titulo: 'Notícias e análises',
    texto: 'Novidades sobre os leitores, as lojas de livros e as funções do Kindle.',
    href: '/blog',
    caixa: 'caixa-coral',
    pill: 'pill-coral',
  },
] as const;
---

<BaseLayout
  titulo="Modelos de Kindle em Portugal (2026)"
  descricao="Compara Kindle básico, Paperwhite, Colorsoft e Scribe. Vê as especificações, as versões e os links para as fichas na Amazon.es."
>
  <section aria-labelledby="titulo-modelos" class="border-b border-creme-200 bg-creme-100">
    <Container largura="largo" classe="py-7 sm:py-10 lg:py-12">
      <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-12">
        <div>
          <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-marca-800">
            <span class="h-px w-7 bg-marca-700" aria-hidden="true"></span>
            Catálogo Kindle · 2026
          </p>
          <h1 id="titulo-modelos" class="mt-4 max-w-[18ch] text-balance text-[clamp(2.25rem,5.4vw,4rem)] font-bold leading-[1.05] text-marinho-900">
            Modelos de Kindle em Portugal
          </h1>
        </div>
        <p class="max-w-prose text-base leading-relaxed text-marinho-600 sm:text-lg lg:pb-1">
          Das 6 polegadas do Kindle básico às 11 do Scribe. Compara os leitores, os ecrãs a cores e as versões para escrever. Cada ficha distingue as variantes e liga à Amazon.es.
        </p>
      </div>
    </Container>
  </section>

  <Container largura="largo" classe="py-8 sm:py-12">
    {modelos.length === 0 ? (
      <p class="text-marinho-600">Ainda não há fichas publicadas. Volta em breve.</p>
    ) : (
      <>
        <EscolherKindle />
        <section aria-labelledby="titulo-fichas-kindle" class="mt-10">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-2 border-b border-creme-200 pb-4 sm:mb-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-marca-800">As fichas</p>
              <h2 id="titulo-fichas-kindle" class="mt-1 text-2xl font-bold text-marinho-900 sm:text-3xl">As quatro famílias Kindle</h2>
            </div>
            <p class="text-sm text-marinho-600">Ecrã, capacidade e versões lado a lado</p>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {modelos.map((modelo) => <CartaoFamiliaKindle modelo={modelo} />)}
          </ul>
        </section>
      </>
    )}
  </Container>

  <section class="border-t border-creme-200 bg-creme-100">
    <Container largura="normal" classe="py-10 sm:py-14">
      <div class="mb-8 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-widest text-marca-800">Mais para explorar</p>
        <h2
          class="mt-3 text-3xl font-bold text-marinho-900 md:text-4xl"
          style="font-family: var(--font-serif); letter-spacing: -0.025em;"
        >
          Já escolheste? Há mais para ver
        </h2>
        <p class="mt-2 text-marinho-600">
          Depois de escolheres o leitor, encontra ebooks em português, guias e respostas para o dia a dia.
        </p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {destaques.map((d) => (
          <li class={`caixa ${d.caixa} group`}>
            <a href={d.href} class="flex h-full flex-col p-6">
              <span class={`pill ${d.pill}`}>{d.etiqueta}</span>
              <h3
                class="mt-3 text-xl font-bold leading-tight text-marinho-900 transition-colors group-hover:text-marca-700"
                style="font-family: var(--font-serif);"
              >
                {d.titulo}
              </h3>
              <p class="mt-2 flex-1 text-sm text-marinho-600">{d.texto}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-marca-700 group-hover:text-marca-800">
                Abrir
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>
