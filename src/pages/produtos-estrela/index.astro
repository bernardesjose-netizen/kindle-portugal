---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { formatarData } from '@lib/formatters';
import { imagemParaAsin } from '@lib/asin-images';

const posts = (await getCollection('produtosEstrela', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf(),
);
---

<BaseLayout
  titulo="Produtos Estrela"
  descricao="Oportunidades verificadas em leitores e acessórios: Kindle na Amazon, Kobo e BOOX na Worten e na Wook. Preços confirmados com data, qualidade avaliada sem hype."
>
  <section class="relative overflow-hidden border-b-4 border-marca-500 bg-gradient-to-br from-marinho-900 via-oceano-800 to-marinho-800 text-creme-50">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(ellipse at top right, rgb(249 126 7 / 0.28) 0%, transparent 55%), radial-gradient(ellipse at bottom left, rgb(20 110 180 / 0.35) 0%, transparent 50%);"
    />
    <Container largura="normal" classe="relative z-10 py-14">
      <span class="inline-flex items-center gap-1 rounded-full border border-marca-400/40 bg-marca-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-marca-300">
        Rubrica regular
      </span>
      <h1 class="mt-3 text-3xl font-bold text-creme-50 md:text-4xl" style="font-family: var(--font-serif);">
        Produtos Estrela
      </h1>
      <p class="mt-3 max-w-2xl text-oceano-100/90">
        De poucos em poucos dias, destacamos leitores e acessórios que valem mesmo a pena:
        Kindle na Amazon, Kobo e BOOX na Worten e na Wook. Cada preço traz a data em que o
        confirmámos na loja — e quando um produto tem limitações, dizemo-lo.
      </p>
    </Container>
  </section>

  <Container largura="normal" classe="py-14">
    {posts.length === 0 ? (
      <p class="text-marinho-600">Ainda não há artigos publicados nesta rubrica.</p>
    ) : (
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => {
          const primeiroComAsin = p.data.produtos.find((pr) => pr.asin);
          const imgSrc = primeiroComAsin?.asin ? imagemParaAsin(primeiroComAsin.asin, 500) : null;
          return (
            <li class="group">
              <a href={`/produtos-estrela/${p.id}`} class="block">
                <div class="relative mb-4 flex h-48 items-center justify-center rounded-xl bg-gradient-to-br from-marinho-50 to-creme-100 p-4 transition-transform group-hover:-translate-y-1">
                  {imgSrc ? (
                    <img
                      src={imgSrc}
                      alt={primeiroComAsin?.nome ?? p.data.titulo}
                      loading="lazy"
                      decoding="async"
                      class="max-h-40 w-auto object-contain"
                      style="mix-blend-mode: multiply; filter: drop-shadow(0 4px 8px rgba(15,26,36,0.18));"
                      referrerpolicy="no-referrer-when-downgrade"
                      onerror="this.style.display='none'"
                    />
                  ) : (
                    <span class="text-4xl" aria-hidden="true">⭐</span>
                  )}
                </div>
                <h2 class="text-lg font-semibold leading-snug text-marinho-900 group-hover:text-marca-600">
                  {p.data.titulo}
                </h2>
                <p class="mt-2 text-sm text-marinho-600">{p.data.descricao}</p>
                <p class="mt-2 text-xs text-marinho-400">
                  <time datetime={p.data.data_publicacao.toISOString()}>
                    {formatarData(p.data.data_publicacao)}
                  </time>
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <p class="mt-12 rounded-xl border border-marinho-100 bg-marinho-50/60 p-4 text-sm text-marinho-600">
      Os preços indicados foram confirmados na loja respetiva na data que acompanha cada produto
      e podem mudar a qualquer momento. Alguns links são de afiliado — se comprares através
      deles, podemos receber uma comissão sem custo adicional para ti.
      <a href="/divulgacao-afiliados" class="underline underline-offset-2 hover:text-marca-700">Sabe mais</a>.
    </p>
  </Container>
</BaseLayout>
