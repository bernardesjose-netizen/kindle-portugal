---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import CartaoMontra from '@components/afiliados/CartaoMontra.astro';
import LinkPrecos from '@components/afiliados/LinkPrecos.astro';
import { getCollection } from 'astro:content';
import { CATEGORIAS_MONTRA, MONTRA, type ItemMontra } from '@lib/montra';

const modelos = await getCollection('modelos', ({ data }) => !data.rascunho);
const kindles = modelos.flatMap<ItemMontra>(({ id, data }) => {
  const fichaUrl = '/modelos/' + id;
  const comum = { marca: data.fabricante, categoria: 'kindle' as const };
  const itens: ItemMontra[] = data.asin ? [{
    ...comum,
    nome: data.nome,
    asin: data.asin,
    ficha_url: fichaUrl,
    porque: data.descricao_curta,
  }] : [];

  return itens.concat(data.variantes.map((v) => ({
    ...comum,
    nome: v.nome,
    asin: v.asin,
    ficha_url: fichaUrl + '#variantes',
    porque: v.descricao,
  })));
});

const grupos = CATEGORIAS_MONTRA.map((c) => ({
  ...c,
  itens: c.id === 'kindle' ? kindles : MONTRA.filter((i) => i.categoria === c.id),
})).filter((g) => g.itens.length > 0);
---

<BaseLayout
  titulo="Montra do leitor: Kindle, capas, cadernos e acessórios"
  descricao="Leitores Kindle, Kobo e PocketBook, capas, cadernos, canetas, luzes de leitura e carregadores. Vê as características e consulta o preço na loja."
  motivoOrnamento="e-reader"
>
  <section aria-labelledby="titulo-montra" class="border-b border-creme-200 bg-creme-100">
    <Container largura="largo" classe="py-7 sm:py-10 lg:py-12">
      <div class="grid items-start gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
        <div>
          <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-marca-800">
            <span class="h-px w-7 bg-marca-700" aria-hidden="true"></span>
            Seleção Kindle Portugal
          </p>
          <h1 id="titulo-montra" class="mt-4 text-balance text-[clamp(2.25rem,5.4vw,4rem)] font-bold leading-[1.05] text-marinho-900">
            Montra do leitor
          </h1>
          <p class="mt-4 max-w-[50ch] text-base leading-relaxed text-marinho-600 sm:text-lg">
            Leitores, capas, cadernos, luzes e ebooks para ler e escrever. Cada cartão indica para que serve o produto e liga à ficha da Amazon.es.
          </p>
        </div>
        <nav aria-label="Categorias da montra" class="rounded-2xl border border-creme-200 bg-creme-50 p-4 sm:p-5">
          <p class="mb-3 text-sm font-semibold text-marinho-900">Ir para uma categoria</p>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {grupos.map((g) => (
              <li>
                <a href={`#${g.id}`} class="flex h-full min-h-10 items-center gap-1.5 rounded-lg border border-creme-200 bg-white px-2.5 py-2 text-sm font-semibold leading-tight text-marinho-900 transition-colors hover:border-marca-500 hover:text-marca-800">
                  {g.titulo} <span aria-hidden="true" class="ml-auto text-marca-800">↓</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </Container>
  </section>

  <Container largura="largo" classe="py-7 sm:py-12">
    <aside class="flex items-start gap-3 rounded-xl border border-marinho-200 bg-white px-4 py-3 text-sm leading-relaxed text-marinho-700 sm:px-5">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="mt-0.5 shrink-0 text-marca-800" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75" />
        <path d="M12 10.5v5M12 8h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
      <p><strong>Preços e entrega.</strong> Os valores da Amazon.es indicam a data em que foram consultados (<LinkPrecos />). Confirma o preço de hoje e a entrega para a tua morada na ficha da loja.</p>
    </aside>

    {grupos.map((g) => (
      <section id={g.id} aria-labelledby={`montra-${g.id}`} class="mt-10 scroll-mt-24 sm:mt-14">
        <div class="border-b border-creme-200 pb-4">
          <div class="flex flex-wrap items-center gap-3">
            <h2 id={`montra-${g.id}`} class="text-2xl font-bold text-marinho-900 sm:text-3xl">{g.titulo}</h2>
            <span class="rounded-full bg-creme-100 px-2.5 py-1 text-xs font-semibold text-marinho-600">{g.itens.length} opções</span>
          </div>
          <p class="mt-1.5 max-w-2xl text-marinho-600">{g.descricao}</p>
        </div>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {g.itens.map((i) => (
            <CartaoMontra
              nome={i.nome}
              marca={i.marca}
              asin={i.asin}
              precoEur={i.preco_eur}
              precoData={i.preco_data}
              expira={i.expira}
              porque={i.porque}
              etiqueta={i.etiqueta}
              fichaUrl={i.ficha_url}
              livro={i.livro}
            />
          ))}
        </ul>
      </section>
    ))}

    <section class="mt-12 rounded-2xl border border-creme-200 bg-creme-100 p-5 sm:mt-16 sm:p-7">
      <h2 class="text-xl font-bold text-marinho-900" style="font-family: var(--font-serif);">Para escolher com calma</h2>
      <ul class="mt-3 space-y-2 text-marinho-700">
        <li>Ainda a decidir que Kindle comprar? O guia <a href="/guias/qual-kindle-comprar-2026" class="font-semibold text-marca-600 hover:text-marca-700">Qual Kindle comprar</a> compara a gama inteira.</li>
        <li>Procuras uma prenda? Há ideias por orçamento em <a href="/guias/presentes-natal-2026-para-quem-le" class="font-semibold text-marca-600 hover:text-marca-700">Presentes de Natal para quem lê</a>.</li>
        <li>Antes da Black Friday, vê o que contar em <a href="/guias/black-friday-2026-kindle" class="font-semibold text-marca-600 hover:text-marca-700">Black Friday 2026 para quem quer um Kindle</a>.</li>
        <li>Fora do mundo da leitura, a tecnologia que recomendamos está nos <a href="/achados-tech" class="font-semibold text-marca-600 hover:text-marca-700">Achados Tech</a>.</li>
      </ul>
    </section>
  </Container>
</BaseLayout>
