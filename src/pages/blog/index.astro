---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import CapaLivroBlog from '@components/editorial/CapaLivroBlog.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { formatarData } from '@lib/formatters';

const artigos = (await getCollection('blog', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf(),
);
const idDestaque = 'amazon-business-nif-empresa-portuguesa-sem-iva-2026';
---

<BaseLayout
  titulo="Blog"
  descricao="Artigos sobre Kindle, ebooks em português de Portugal, audiolivros e funções dos leitores digitais."
>
  <div class="tipografia-blog">
  <section class="relative overflow-hidden border-b-4 border-dourado-500 bg-gradient-to-br from-marinho-900 via-oceano-800 to-marinho-800 text-creme-50">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(ellipse at top right, rgb(212 168 75 / 0.30) 0%, transparent 55%), radial-gradient(ellipse at bottom left, rgb(20 110 180 / 0.35) 0%, transparent 50%);"
    />
    <Container largura="normal" classe="relative z-10 py-14">
      <span class="inline-flex items-center gap-1 rounded-full border border-dourado-400/40 bg-dourado-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-dourado-400">
        Blog
      </span>
      <h1 class="mt-3 text-3xl font-bold text-creme-50 md:text-4xl" style="font-family: var(--font-blog); letter-spacing: -0.035em;">
        Blog do Kindle Portugal
      </h1>
      <p class="mt-3 max-w-2xl text-oceano-100/90">
        Guias para usar o Kindle, encontrar livros em português e ler noutros formatos.
      </p>
    </Container>
  </section>

  <Container largura="normal" classe="py-14">
    {artigos.length === 0 ? (
      <p class="text-marinho-600">Ainda não há artigos publicados.</p>
    ) : (
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {artigos.map((a) => (
          <li class:list={['group', a.id === idDestaque && 'artigo-assinalado']}>
            <a href={`/blog/${a.id}`} class="block">
              {a.data.capa_livro ? (
                <div class="relative mb-4 aspect-[1200/630] overflow-hidden rounded-xl bg-gradient-to-br from-marinho-100 to-creme-100 transition-transform group-hover:-translate-y-1">
                  <CapaLivroBlog livro={a.data.capa_livro} />
                </div>
              ) : a.data.imagem_hero && (
                <div class:list={['relative mb-4 overflow-visible rounded-xl bg-gradient-to-br from-marinho-50 to-creme-100 transition-transform group-hover:-translate-y-1', a.id === idDestaque && 'capa-assinalada']}>
                  {a.id === idDestaque && (
                    <span class="etiqueta-assinalada" aria-hidden="true">Para empresas</span>
                  )}
                  <Image
                    src={a.data.imagem_hero}
                    alt={a.data.imagem_hero_alt ?? a.data.titulo}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                    class="block aspect-[1200/630] w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <h2 class="text-lg font-semibold leading-snug text-marinho-900 group-hover:text-marca-700">
                {a.data.titulo}
              </h2>
              <p class="mt-2 text-sm text-marinho-600">{a.data.descricao}</p>
              <p class="mt-2 text-xs text-marinho-400">
                <time datetime={a.data.data_publicacao.toISOString()}>
                  {formatarData(a.data.data_publicacao)}
                </time>
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Container>
  </div>
</BaseLayout>

<style>
  .capa-assinalada::before,
  .capa-assinalada::after {
    position: absolute;
    z-index: 2;
    border: 3px solid rgb(249 126 7 / 0.78);
    content: '';
    inset: -7px -9px -8px -8px;
    pointer-events: none;
    border-radius: 47% 53% 49% 51% / 8% 10% 9% 11%;
    transform: rotate(-0.7deg);
  }

  .capa-assinalada::after {
    border-width: 2px;
    border-color: rgb(249 126 7 / 0.38);
    inset: -4px -12px -11px -5px;
    transform: rotate(0.55deg);
  }

  .etiqueta-assinalada {
    position: absolute;
    z-index: 3;
    top: -14px;
    right: 12px;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: #f97e07;
    box-shadow: 0 4px 12px rgb(14 24 41 / 0.18);
    color: #0b111a;
    font-family: Arial, sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(2deg);
  }

  .artigo-assinalado h2 {
    text-decoration: underline;
    text-decoration-color: rgb(249 126 7 / 0.42);
    text-decoration-thickness: 0.22em;
    text-underline-offset: -0.08em;
    text-decoration-skip-ink: none;
  }
</style>
