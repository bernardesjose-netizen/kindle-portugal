---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import CardProdutoEstrela from '@components/CardProdutoEstrela.astro';
import { ACHADOS_TECH, CATEGORIAS_ACHADOS, VERIFICADO_EM } from '@lib/achados-tech';
import { formatarData } from '@lib/formatters';

const porCategoria = CATEGORIAS_ACHADOS.map((categoria) => ({
  ...categoria,
  itens: ACHADOS_TECH.filter((achado) => achado.categoria === categoria.id),
})).filter((grupo) => grupo.itens.length > 0);
---

<BaseLayout
  titulo="Achados Tech na Amazon.es"
  descricao="Leitores, capas Kindle e Kobo, carregadores USB-C, auscultadores, Fire TV e tecnologia para casa. Compara as variantes e consulta as fichas na Amazon.es."
  motivoOrnamento="e-reader"
>
  <section class="relative overflow-hidden border-b-4 border-oceano-500 bg-gradient-to-br from-marinho-900 via-oceano-800 to-marinho-800 text-creme-50">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(ellipse at top right, rgb(20 110 180 / 0.40) 0%, transparent 55%), radial-gradient(ellipse at bottom left, rgb(249 126 7 / 0.22) 0%, transparent 50%);"
    />
    <Container largura="normal" classe="relative z-10 py-10 sm:py-14">
      <p class="text-sm font-semibold text-oceano-100">
        {ACHADOS_TECH.length} produtos · Fichas verificadas a {formatarData(VERIFICADO_EM)}
      </p>
      <h1 class="mt-3 text-3xl font-bold text-creme-50 md:text-4xl" style="font-family: var(--font-serif);">
        Achados Tech na Amazon.es
      </h1>
      <p class="mt-3 max-w-2xl text-oceano-100">
        Do comando que vira as páginas do Kindle ao carregador que fica na mochila.
        Vê para que serve cada produto, com que aparelhos funciona e qual é a variante na Amazon.es.
      </p>
      <nav aria-label="Categorias de Achados Tech" class="mt-6">
        <ul class="flex flex-wrap gap-2">
          {porCategoria.map((grupo) => (
            <li>
              <a href={'#' + grupo.id} class="inline-flex min-h-10 items-center gap-2 rounded-full border border-creme-50/30 bg-creme-50/10 px-3 text-sm font-semibold text-creme-50 hover:bg-creme-50/20 focus-visible:outline-2 focus-visible:outline-offset-2">
                {grupo.nome} <span class="text-oceano-100">{grupo.itens.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </Container>
  </section>

  <Container largura="normal" classe="py-8 sm:py-10">
    <p class="rounded-xl border border-marinho-100 bg-creme-50 p-4 text-sm text-marinho-700">
      Confirma o preço e a entrega para a tua morada na Amazon.es. Nas fichas encontras também ligações para as outras lojas Amazon.
    </p>

    {porCategoria.map((grupo) => (
      <section id={grupo.id} aria-labelledby={'titulo-' + grupo.id} class="mt-10 scroll-mt-24">
        <h2 id={'titulo-' + grupo.id} class="mb-4 text-2xl font-bold text-marinho-900" style="font-family: var(--font-serif); letter-spacing: -0.02em;">
          {grupo.nome}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {grupo.itens.map((achado) => (
            <CardProdutoEstrela
              nome={achado.nome}
              loja="amazon"
              asin={achado.asin}
              etiqueta={achado.etiqueta}
              comentario={achado.comentario}
              numero={1}
              total={1}
              compacto
            />
          ))}
        </div>
      </section>
    ))}

    <p class="mt-10 text-center text-sm text-marinho-600">
      Podes ver mais sugestões de leitura nos
      <a href="/produtos-estrela" class="font-semibold text-marca-700 underline underline-offset-2">Produtos Estrela</a>.
    </p>
  </Container>
</BaseLayout>
