---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import DestaqueCampanha from '@components/afiliados/DestaqueCampanha.astro';
import CartaoFamiliaKindle from '@components/CartaoFamiliaKindle.astro';
import OfertasMomento from '@components/afiliados/OfertasMomento.astro';
import WookWidget from '@components/afiliados/WookWidget.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@lib/site';
import { formatarData } from '@lib/formatters';
import { imagemParaAsin } from '@lib/asin-images';
import { urlCapaLivro } from '@lib/capa-livro';

const ordemModelos: Record<string, number> = { basico: 0, paperwhite: 1, colorsoft: 2, scribe: 3 };
const modelos = (await getCollection('modelos', ({ data }) => !data.rascunho))
  .sort((a, b) => (ordemModelos[a.id] ?? 4) - (ordemModelos[b.id] ?? 4))
  .slice(0, 4);
const totalVersoes = modelos.reduce((total, { data }) => total + 1 + data.variantes.length, 0);
const paperwhite = modelos.find(({ id }) => id === 'paperwhite')?.data;
const imagemHero = paperwhite?.asin ? imagemParaAsin(paperwhite.asin, 500) : null;

const guiasTodos = (await getCollection('guias', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf());
const guias = guiasTodos.slice(0, 4);

const blogTodos = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf());
const ultimoPost = blogTodos[0];

const tresLivrosTodos = (await getCollection('tresLivros', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data_publicacao.valueOf() - a.data.data_publicacao.valueOf());
const ultimoTresLivros = tresLivrosTodos[0];

const categoriasGuia: Record<string, string> = {
  comprar: 'Comprar',
  utilizar: 'Utilizar',
  'converter-e-enviar': 'Converter e enviar',
  ebooks: 'Ebooks',
  problemas: 'Resolver problemas',
  comparacoes: 'Comparações',
};

const caixaPorCategoria: Record<string, string> = {
  comprar: 'caixa-marca',
  utilizar: 'caixa-oceano',
  'converter-e-enviar': 'caixa-salvia',
  ebooks: 'caixa-dourado',
  problemas: 'caixa-ambar',
  comparacoes: 'caixa-marinho',
};

const pillPorCategoria: Record<string, string> = {
  comprar: '',
  utilizar: 'pill-oceano',
  'converter-e-enviar': 'pill-salvia',
  ebooks: 'pill-dourado',
  problemas: 'pill-ambar',
  comparacoes: 'pill-marinho',
};
---

<BaseLayout titulo={SITE.nome} descricao={SITE.descricao}>
  <section aria-labelledby="titulo-gama-kindle" class="border-b border-creme-200 bg-creme-100">
    <Container largura="largo" classe="py-8 sm:py-12 lg:py-16">
      <div class="grid items-center gap-7 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div>
          <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-marca-800">
            <span class="h-px w-7 bg-marca-700" aria-hidden="true"></span>
            Grande atualização do site · novembro de 2026
          </p>
          <h1 id="titulo-gama-kindle" class="mt-4 max-w-[14ch] text-balance text-[clamp(2.3rem,6vw,4.5rem)] font-bold leading-[1.04] text-marinho-900">
            Conhece os novos modelos Kindle
          </h1>
          <p class="mt-4 max-w-[52ch] text-pretty text-base leading-relaxed text-marinho-600 sm:text-lg">
            Compara {totalVersoes} versões, das mais leves para ler às Signature e aos Scribe de 11 polegadas. Reunimos as diferenças que importam, com fichas da Amazon e testes independentes.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <a href="/modelos" class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-marca-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-marca-800 sm:px-5">
              Ver os modelos Kindle <span aria-hidden="true">→</span>
            </a>
            <a href="/guias/qual-kindle-comprar-2026" class="inline-flex min-h-11 items-center rounded-lg border border-marinho-200 bg-creme-50 px-4 py-2.5 text-sm font-semibold text-marinho-900 transition-colors hover:border-marca-700 sm:px-5">
              Comparar modelos
            </a>
            {ultimoTresLivros && (
              <a href="#tres-ebooks-na-entrada" class="inline-flex min-h-11 items-center gap-2 px-2 text-sm font-semibold text-marca-800 underline decoration-dourado-400 underline-offset-4 hover:text-marinho-900">
                Três Ebooks <span aria-hidden="true">↓</span>
              </a>
            )}
          </div>
          <nav aria-label="Famílias Kindle" class="mt-6 max-w-2xl border-t border-creme-200 pt-4">
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              {modelos.map(({ id, data }) => (
                <li>
                  <a href={'/modelos/' + id} class="flex h-full min-h-10 items-center justify-between gap-1 rounded-lg border border-creme-200 bg-white px-2.5 py-2 text-sm font-semibold leading-tight text-marinho-900 hover:border-marca-500 hover:text-marca-800">
                    {data.nome} <span aria-hidden="true" class="text-marca-800">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        {imagemHero && paperwhite && (
          <figure class="overflow-hidden rounded-3xl border border-creme-200 bg-creme-50 shadow-media">
            <a href="/modelos/paperwhite" class="kindle-palco group flex h-52 items-center justify-center overflow-hidden px-6 py-5 sm:h-72 lg:h-[22rem]" aria-label="Ver Kindle Paperwhite">
              <img
                src={imagemHero}
                alt={paperwhite.imagem_hero_alt ?? paperwhite.nome}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="500"
                height="500"
                class="h-full w-full object-contain mix-blend-multiply motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.04]"
                referrerpolicy="no-referrer-when-downgrade"
                data-fallback="/placeholder-amazon.svg"
              />
            </a>
            <figcaption class="flex items-center justify-between gap-3 border-t border-creme-200 px-4 py-3 sm:px-6 sm:py-4">
              <div>
                <p class="text-[0.68rem] font-bold uppercase tracking-widest text-marca-800">Em destaque</p>
                <p class="mt-0.5 font-serif text-lg font-bold text-marinho-900">{paperwhite.nome}</p>
              </div>
              <span class="rounded-full border border-creme-200 bg-white px-3 py-1 text-xs font-semibold text-marinho-600">
                {paperwhite.especificacoes.ecra_polegadas}″ · {paperwhite.ano_lancamento}
              </span>
            </figcaption>
          </figure>
        )}
      </div>
    </Container>
  </section>

  {ultimoTresLivros && (
    <section id="tres-ebooks-na-entrada" aria-labelledby="titulo-tres-ebooks-entrada" class="relative scroll-mt-24 overflow-hidden border-y border-dourado-200/70 bg-gradient-to-br from-dourado-50 via-creme-50 to-dourado-100/50">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-60"
        style="background-image: radial-gradient(ellipse at 15% 25%, rgb(212 168 75 / 0.18) 0%, transparent 50%), radial-gradient(ellipse at 85% 80%, rgb(249 126 7 / 0.10) 0%, transparent 50%);"
      />
      <Container largura="normal" classe="relative z-10 py-16">
        <div class="mb-8 flex items-end justify-between">
          <div>
            <span class="pill pill-dourado">De dois em dois dias</span>
            <h2 id="titulo-tres-ebooks-entrada" class="mt-3 text-3xl font-bold text-marinho-900 md:text-4xl" style="font-family: var(--font-serif); letter-spacing: -0.025em;">
              Três Ebooks
            </h2>
            <p class="mt-2 max-w-xl text-marinho-600">
              Três ebooks de dois em dois dias, escritos originalmente em português de Portugal e publicados por editoras portuguesas.
            </p>
          </div>
          <a
            href="/tres-livros"
            class="hidden shrink-0 text-sm font-semibold text-marca-600 hover:text-marca-700 sm:inline-flex"
          >
            Ver rubrica →
          </a>
        </div>

        <article class="group overflow-hidden rounded-2xl border border-dourado-200/60 bg-creme-50/90 shadow-sm backdrop-blur-sm transition-all hover:shadow-md">
          <a href={`/tres-livros/${ultimoTresLivros.id}`} class="grid gap-8 p-8 md:grid-cols-[auto_1fr] md:items-center md:gap-10 md:p-10">
            <div class="relative mx-auto w-full max-w-sm md:mx-0 md:w-80 lg:w-96">
              <div
                class="absolute -inset-4 rounded-full opacity-40 blur-2xl"
                aria-hidden="true"
                style="background: radial-gradient(ellipse at center, rgba(212, 168, 75, 0.45) 0%, rgba(20, 110, 180, 0.20) 60%, transparent 80%);"
              />
              <div class="relative grid grid-cols-3 gap-3">
                {ultimoTresLivros.data.livros.map((livro, i) => (
                  <img
                    src={urlCapaLivro(livro.asin, 'medio', livro.capa_amazon)}
                    alt={`Capa de ${livro.titulo}`}
                    loading="lazy"
                    decoding="async"
                    width="200"
                    height="300"
                    class="block h-auto w-full rounded object-contain transition-transform duration-500"
                    style={`filter: drop-shadow(0 8px 14px rgba(15,26,36,0.20)); transform: rotate(${i === 0 ? '-2deg' : i === 1 ? '0deg' : '2deg'}); transform-origin: bottom;`}
                    referrerpolicy="no-referrer-when-downgrade"
                    data-fallback="hide"
                  />
                ))}
              </div>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-marca-600">
                <time datetime={ultimoTresLivros.data.data_publicacao.toISOString()}>
                  {formatarData(ultimoTresLivros.data.data_publicacao)}
                </time>
              </p>
              <h3
                class="mt-2 text-2xl font-bold leading-tight text-marinho-900 transition-colors group-hover:text-marca-700 md:text-3xl"
                style="font-family: var(--font-serif); letter-spacing: -0.02em;"
              >
                {ultimoTresLivros.data.titulo}
              </h3>
              <p class="mt-4 text-marinho-600">{ultimoTresLivros.data.descricao}</p>

              <ul class="mt-5 space-y-1.5 text-sm text-marinho-700">
                {ultimoTresLivros.data.livros.map((livro) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-2 inline-block h-1 w-1 shrink-0 rounded-full bg-dourado-500" aria-hidden="true" />
                    <span>
                      <strong class="font-semibold text-marinho-900">{livro.titulo}</strong>
                      <span class="text-marinho-500">, {livro.autor} · {livro.editora}</span>
                    </span>
                  </li>
                ))}
              </ul>

              {ultimoTresLivros.data.convidado_ingles && (
                <p class="mt-4 text-sm text-oceano-800">Em inglês · <em>{ultimoTresLivros.data.convidado_ingles.titulo}</em></p>
              )}

              <p class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-marca-600 group-hover:text-marca-700">
                Ler edição completa
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </p>
            </div>
          </a>
        </article>

        <div class="mt-6 text-center sm:hidden">
          <a href="/tres-livros" class="text-sm font-semibold text-marca-600 hover:text-marca-700">
            Ver rubrica completa →
          </a>
        </div>
      </Container>
    </section>
  )}

  <DestaqueCampanha />

  {/* Grandes marcas com desconto de 35 % ou mais (src/lib/ofertas-momento.ts).
      Cada oferta caduca sozinha no browser. */}
  <OfertasMomento limite={8} verTodas />

  {ultimoPost && (
    <Container largura="normal" classe="pt-8">
      <a
        href={`/blog/${ultimoPost.id}`}
        class="group flex flex-col gap-3 rounded-2xl border border-marca-200 bg-gradient-to-r from-marca-50 via-creme-50 to-oceano-50 p-5 transition-all hover:-translate-y-0.5 hover:border-marca-300 hover:shadow-md sm:flex-row sm:items-center sm:gap-5 sm:p-6"
        aria-label={`Novo no blog: ${ultimoPost.data.titulo}`}
      >
        <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-marca-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-sm sm:self-center">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
          </span>
          Novidade
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold uppercase tracking-wider text-marca-600">Novo no blog</p>
          <p
            class="mt-0.5 text-lg font-bold leading-snug text-marinho-900 transition-colors group-hover:text-marca-700"
            style="font-family: var(--font-serif);"
          >
            {ultimoPost.data.titulo}
          </p>
        </div>
        <span class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-marca-600 group-hover:text-marca-700">
          Ler agora
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
    </Container>
  )}

  <Container largura="normal" classe="pt-6">
    <WookWidget prioridade />
  </Container>

  {modelos.length > 0 && (
    <section aria-labelledby="titulo-modelos-destaque" class="bg-creme-50">
      <Container largura="largo" classe="py-12 sm:py-16">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-x-8 gap-y-2 sm:mb-8">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-marca-800">A gama Kindle</p>
            <h2 id="titulo-modelos-destaque" class="mt-2 text-3xl font-bold leading-tight text-marinho-900 md:text-4xl">
              Quatro famílias para ler e escrever
            </h2>
            <p class="mt-2 max-w-2xl text-marinho-600">
              Vê o ecrã e a capacidade de cada família. Abre a ficha para comparar as versões e confirmar o preço e a entrega na loja.
            </p>
          </div>
          <a href="/modelos" class="inline-flex min-h-10 items-center gap-2 text-sm font-semibold text-marca-800 hover:underline">
            Ver todos os modelos <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {modelos.map((modelo) => <CartaoFamiliaKindle modelo={modelo} />)}
        </ul>
      </Container>
    </section>
  )}

  {guias.length > 0 && (
    <section class="relative border-y border-oceano-200 bg-gradient-to-br from-oceano-50 via-white to-oceano-50">
      <Container largura="normal" classe="py-16">
        <div class="mb-8 flex items-end justify-between">
          <div>
            <span class="pill pill-oceano">Guias</span>
            <h2 class="mt-3 text-3xl font-bold text-oceano-900 md:text-4xl" style="letter-spacing: -0.025em;">
              Guias recentes
            </h2>
            <p class="mt-2 text-oceano-700/80">Passo a passo, sem floreados.</p>
          </div>
          <a
            href="/guias"
            class="hidden shrink-0 text-sm font-semibold text-oceano-600 hover:text-oceano-700 sm:inline-flex"
          >
            Ver todos →
          </a>
        </div>
        <ul class="grid gap-6 md:grid-cols-2">
          {guias.map((g) => (
            <li class={`caixa ${caixaPorCategoria[g.data.categoria] ?? 'caixa-marca'} group`}>
              <a href={`/guias/${g.id}`} class="block p-6">
                <span class={`pill ${pillPorCategoria[g.data.categoria] ?? ''}`}>
                  {categoriasGuia[g.data.categoria] ?? g.data.categoria}
                </span>
                <h3
                  class="mt-3 text-2xl font-bold leading-tight text-marinho-900 transition-colors group-hover:text-marca-700"
                  style="font-family: var(--font-serif);"
                >
                  {g.data.titulo}
                </h3>
                <p class="mt-3 text-marinho-600">{g.data.descricao}</p>
                {g.data.tempo_leitura_min && (
                  <p class="mt-4 text-xs text-marinho-400">
                    {g.data.tempo_leitura_min} min de leitura
                  </p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}

  <Container largura="normal">
  </Container>
</BaseLayout>

<style>
  .kindle-palco {
    background:
      radial-gradient(ellipse at 50% 30%, var(--color-creme-50) 0%, transparent 68%),
      linear-gradient(145deg, var(--color-creme-100), var(--color-creme-200));
  }
</style>
