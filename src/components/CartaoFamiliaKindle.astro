---
import type { CollectionEntry } from 'astro:content';
import EstadoStock from '@components/afiliados/EstadoStock.astro';
import { imagemParaAsin } from '@lib/asin-images';
import { formatarData, formatarPreco } from '@lib/formatters';
import { rotuloPreco } from '@lib/disponibilidade';

interface Props {
  modelo: CollectionEntry<'modelos'>;
}

const { modelo } = Astro.props;
const { id, data } = modelo;
const specs = data.especificacoes;
const imagem = data.asin ? imagemParaAsin(data.asin, 500) : undefined;
const ecra = new Intl.NumberFormat('pt-PT').format(specs.ecra_polegadas);
const variantes = data.variantes.length;
---

<li class="group min-w-0">
  <a
    href={`/modelos/${id}`}
    class="flex h-full flex-col rounded-2xl border border-marinho-200 bg-white p-3 shadow-suave transition-colors hover:border-marca-400 sm:p-4"
  >
    <div class="relative flex aspect-[5/3] items-center justify-center rounded-xl border border-creme-200 bg-creme-100 p-5 sm:p-6">
      <span class="absolute left-2 top-2 rounded-full bg-creme-50 px-2.5 py-0.5 text-xs font-semibold text-marinho-600">
        {data.ano_lancamento}
      </span>
      {imagem ? (
        <img
          src={imagem}
          alt=""
          loading="lazy"
          decoding="async"
          width="240"
          height="240"
          class="h-full w-full object-contain mix-blend-multiply motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.04]"
          referrerpolicy="no-referrer-when-downgrade"
          data-fallback="/placeholder-amazon.svg"
        />
      ) : (
        <svg width="48" height="56" viewBox="0 0 48 56" fill="none" aria-hidden="true" class="text-marinho-300">
          <rect x="5" y="3" width="38" height="50" rx="4" stroke="currentColor" stroke-width="2" />
          <path d="M14 16h20M14 23h20M14 30h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      )}
    </div>
    <div class="flex flex-1 flex-col px-1 pb-1 pt-4">
      <h3 class="text-[1.35rem] font-bold leading-tight text-marinho-900 group-hover:text-marca-800">
        {data.nome}
      </h3>
      <p class="mt-1.5 text-xs font-semibold leading-relaxed text-marinho-600">
        {ecra}″ · {specs.memoria_gb} GB
        {specs.stylus_incluido ? ' · Com caneta' : specs.ecra_cor ? ' · A cores' : ''}
      </p>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-marinho-600">{data.descricao_curta}</p>
      {variantes > 0 && (
        <p class="mt-3 text-xs font-semibold text-marinho-600">{variantes + 1} versões na ficha</p>
      )}
      {data.preco_referencia_eur != null && (
        <div class="mt-3 space-y-1.5 border-t border-creme-200 pt-3 text-sm">
          <p class="flex flex-wrap items-baseline gap-x-1.5">
            <span class="text-marinho-600">{rotuloPreco(data.disponibilidade)}</span>
            <strong class="text-base text-marinho-900">{formatarPreco(data.preco_referencia_eur)}</strong>
          </p>
          {data.preco_data && <p class="text-xs text-marinho-600">Preço a {formatarData(data.preco_data)}</p>}
          {data.disponibilidade && (
            <EstadoStock estado={data.disponibilidade} data={data.disponibilidade_data} />
          )}
        </div>
      )}
      <span class="mt-3 flex min-h-10 items-center justify-between gap-2 rounded-lg bg-marca-50 px-3 text-sm font-semibold text-marca-800 transition-colors group-hover:bg-marca-100">
        Ver a ficha
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</li>
