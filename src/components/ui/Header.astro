---
import Container from './Container.astro';
import { SITE, NAVEGACAO_PRINCIPAL } from '@lib/site';
import { caminhoPublico } from '@lib/urls';

const caminhoAtual = caminhoPublico(Astro.url.pathname);
const atalhos = NAVEGACAO_PRINCIPAL.filter((item) => item.visivel !== 'menu');
const classesBarra = { tablet: 'md:block', portatil: 'lg:block', desktop: 'xl:block' };
const classesMenu = { menu: '', tablet: 'md:hidden', portatil: 'lg:hidden', desktop: 'xl:hidden' };
const caminhoAtivo = NAVEGACAO_PRINCIPAL
  .filter(({ href }) => caminhoAtual === href || (href !== '/' && caminhoAtual.startsWith(href + '/')))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="sticky top-0 z-40 border-b border-marinho-200/70 bg-creme-50/95 shadow-suave backdrop-blur-md">
  <div class="h-0.5 bg-gradient-to-r from-marca-600 via-marca-300 to-oceano-600" aria-hidden="true"></div>
  <Container largura="largo" classe="flex min-h-16 items-center justify-between gap-3 py-2 xl:gap-5">
    <a href="/" class="group flex min-h-11 shrink-0 items-center gap-2.5 rounded-md text-marinho-900" aria-label={SITE.nome + ' · Início'} aria-current={caminhoAtual === '/' ? 'page' : undefined}>
      <svg
        class="h-9 w-9 shrink-0"
        viewBox="0 0 32 32"
        aria-hidden="true"
      >
        <rect width="32" height="32" rx="7" fill="currentColor" />
        <rect x="7" y="5" width="18" height="22" rx="2" fill="#fefbf5" />
        <rect x="10" y="9" width="12" height="1.4" fill="#4a5568" />
        <rect x="10" y="12" width="12" height="1.4" fill="#4a5568" />
        <rect x="10" y="15" width="9" height="1.4" fill="#4a5568" />
        <circle cx="16" cy="23" r="1.6" fill="#f97e07" />
      </svg>
      <span class="text-[1.05rem] font-bold tracking-tight" style="font-family: var(--font-serif);">
        Kindle <span class="text-marca-700">Portugal</span>
      </span>
    </a>

    <nav aria-label="Navegação principal" class="flex min-w-0 items-center gap-2">
      <ul class="barra-links hidden items-center text-sm md:flex xl:gap-1">
        {atalhos.map((item) => (
          <li class:list={['hidden', classesBarra[item.visivel]]}>
            <a
              href={item.href}
              class:list={['nav-link', caminhoAtivo === item.href && 'ativo']}
              aria-current={caminhoAtivo === item.href ? (caminhoAtual === item.href ? 'page' : 'location') : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <details data-menu-principal class="relative xl:hidden">
        <summary class="menu-toggle flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-marinho-200 bg-white px-3 text-sm font-semibold text-marinho-900 transition-colors hover:border-marca-700 hover:bg-marca-50">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0 md:hidden" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span class="md:hidden">Menu</span>
          <span class="hidden md:inline">Mais</span>
          <svg viewBox="0 0 16 16" class="hidden size-3 shrink-0 md:block" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m4 6 4 4 4-4" />
          </svg>
        </summary>
        <ul class="menu-painel absolute right-0 top-[calc(100%+0.75rem)] grid gap-1.5 rounded-2xl border border-marinho-200 bg-creme-50 p-3 text-sm shadow-forte min-[360px]:grid-cols-2">
          {NAVEGACAO_PRINCIPAL.map((item) => (
            <li class={classesMenu[item.visivel]}>
              <a
                href={item.href}
                class:list={['nav-link w-full rounded-lg', caminhoAtivo === item.href && 'ativo']}
                aria-current={caminhoAtivo === item.href ? (caminhoAtual === item.href ? 'page' : 'location') : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </Container>
</header>

<style>
  .barra-links .nav-link {
    padding-inline: clamp(0.45rem, 0.7vw, 0.7rem);
    white-space: nowrap;
  }

  .menu-toggle {
    list-style: none;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  details[open] > .menu-toggle {
    border-color: var(--color-marca-700);
    background: var(--color-marca-50);
  }

  details:not([open]) > .menu-painel {
    display: none;
  }

  .menu-painel {
    inline-size: min(26rem, calc(100vw - 2rem));
    max-block-size: calc(100dvh - 5.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu-principal]');
  const botao = menu?.querySelector('summary');

  if (menu && botao) {
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      event.preventDefault();
      menu.open = false;
      botao.focus();
    });

    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
  }
</script>
