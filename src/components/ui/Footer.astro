---
import Container from './Container.astro';
import { SITE, NAVEGACAO_RODAPE } from '@lib/site';

const ano = new Date().getFullYear();
const atalhos = [
  { href: '/modelos', label: 'Modelos Kindle' },
  { href: '/guias', label: 'Guias' },
  { href: '/tres-livros', label: 'Três Ebooks' },
  { href: '/modelos-boox', label: 'Modelos BOOX' },
  { href: '/blog', label: 'Blog' },
  { href: '/faq', label: 'FAQ' },
];
---

<footer class="relative mt-16 overflow-hidden border-t-4 border-marca-500 bg-marinho-900 text-creme-100 sm:mt-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.12]"
    style="background-image: radial-gradient(circle at 20% 0%, #f97e07 0%, transparent 55%), radial-gradient(circle at 95% 120%, #d4a84b 0%, transparent 45%);"
  />

  <Container largura="largo" classe="relative z-10 py-10 text-sm sm:py-12">
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex min-h-11 items-center gap-2.5 rounded-md text-creme-50 hover:text-marca-300">
          <svg class="h-9 w-9" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#f97e07" />
            <rect x="7" y="5" width="18" height="22" rx="2" fill="#fefbf5" />
            <rect x="10" y="9" width="12" height="1.4" fill="#4a5568" />
            <rect x="10" y="12" width="12" height="1.4" fill="#4a5568" />
            <rect x="10" y="15" width="9" height="1.4" fill="#4a5568" />
            <circle cx="16" cy="23" r="1.6" fill="#131a24" />
          </svg>
          <span class="text-xl font-bold" style="font-family: var(--font-serif);">
            {SITE.nome}
          </span>
        </a>
        <p class="mt-3 max-w-sm leading-relaxed text-creme-100/90">{SITE.descricao}</p>
        <a href="/guias/qual-kindle-comprar-2026" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-lg border border-marca-300/50 px-3 font-semibold text-marca-300 hover:border-marca-300 hover:bg-marca-500/10">
          Comparar modelos Kindle <span aria-hidden="true">→</span>
        </a>
      </div>

      <nav aria-labelledby="rodape-conteudo">
        <h2 id="rodape-conteudo" class="text-sm font-semibold text-marca-300">Explorar o site</h2>
        <ul class="mt-2 grid grid-cols-2 gap-x-4 text-creme-100/90 sm:grid-cols-1 xl:grid-cols-2">
          {atalhos.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-11 items-center rounded-sm hover:text-marca-300 hover:underline hover:underline-offset-4">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="rodape-informacoes">
        <h2 id="rodape-informacoes" class="text-sm font-semibold text-marca-300">Informações do site</h2>
        <ul class="mt-2 grid grid-cols-2 gap-x-4 text-creme-100/90 sm:grid-cols-1 xl:grid-cols-2">
          {NAVEGACAO_RODAPE.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-11 items-center rounded-sm hover:text-marca-300 hover:underline hover:underline-offset-4">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-creme-100/20 pt-4">
      <p class="text-xs text-creme-100/80">© {ano} {SITE.nome}. Feito em Portugal.</p>
      <a href="#topo" class="inline-flex min-h-11 items-center gap-2 rounded-sm font-semibold text-marca-300 hover:underline hover:underline-offset-4">
        Voltar ao topo <span aria-hidden="true">↑</span>
      </a>
    </div>
    <p class="mt-2 max-w-3xl text-xs leading-relaxed text-creme-100/75">
      Kindle Portugal é um site independente. Na qualidade de afiliados da Amazon, recebemos comissões por compras elegíveis, sem custo adicional para ti.
      <a href="/divulgacao-afiliados" class="underline underline-offset-2 hover:text-marca-300">Como funciona</a>.
      «Kindle» e o logótipo Amazon são marcas registadas dos respetivos titulares.
    </p>
  </Container>
</footer>
