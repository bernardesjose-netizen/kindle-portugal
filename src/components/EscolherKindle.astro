---
const perfis = [
  { id: 'basico', titulo: 'Leio sobretudo texto', detalhe: 'Kindle básico · 6″' },
  { id: 'paperwhite', titulo: 'Quero um ecrã maior', detalhe: 'Paperwhite · 7″ e luz quente' },
  { id: 'colorsoft', titulo: 'Leio livros ilustrados', detalhe: 'Colorsoft · 7″ a cores' },
  { id: 'scribe', titulo: 'Escrevo e leio PDFs', detalhe: 'Scribe · 11″ e caneta' },
];
---

<section aria-labelledby="titulo-perfis-kindle" class="rounded-2xl border border-creme-200 bg-white p-5 shadow-suave sm:p-7">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 id="titulo-perfis-kindle" class="text-2xl font-bold leading-tight text-marinho-900">Como vais usar o Kindle?</h2>
    <a href="/guias/qual-kindle-comprar-2026" class="inline-flex min-h-10 items-center gap-2 text-sm font-semibold text-marca-800 hover:underline">
      Comparar toda a gama <span aria-hidden="true">→</span>
    </a>
  </div>
  <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
    {perfis.map(({ id, titulo, detalhe }) => (
      <li>
        <a href={`/modelos/${id}`} class="group flex h-full min-h-16 items-center justify-between gap-3 rounded-xl border border-creme-200 bg-creme-50 px-3.5 py-3 transition-colors hover:border-marca-400 hover:bg-marca-50">
          <span>
            <span class="block text-sm font-semibold text-marinho-900">{titulo}</span>
            <span class="mt-0.5 block text-xs text-marinho-600">{detalhe}</span>
          </span>
          <span aria-hidden="true" class="text-marca-800">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>
