---
import { imagemParaAsin } from '@lib/asin-images';
import { urlAfiliado } from '@lib/afiliados';
import { linkWook } from '@lib/wook';
import { formatarPreco, formatarData } from '@lib/formatters';

interface Props {
  nome: string;
  loja: 'amazon' | 'worten' | 'wook';
  asin?: string;
  urlWorten?: string;
  urlWook?: string;
  precoEur?: number;
  precoAnteriorEur?: number;
  precoData?: Date;
  classificacao?: number;
  numAvaliacoes?: number;
  etiqueta?: string;
  comentario: string;
  numero: number;
  total: number;
}

const {
  nome,
  loja,
  asin,
  urlWorten,
  urlWook,
  precoEur,
  precoAnteriorEur,
  precoData,
  classificacao,
  numAvaliacoes,
  etiqueta,
  comentario,
  numero,
  total,
} = Astro.props;

const NOME_LOJA: Record<Props['loja'], string> = {
  amazon: 'Amazon.es',
  worten: 'Worten',
  wook: 'Wook',
};

const imgSrc = asin ? imagemParaAsin(asin, 500) : null;

// Botões de compra: o da loja principal primeiro, alternativas depois.
const botoes: { rotulo: string; url: string; rel: string; principal: boolean }[] = [];
if (loja === 'amazon' && asin) {
  botoes.push({
    rotulo: 'Ver preço na Amazon.es',
    url: urlAfiliado(`https://www.amazon.es/dp/${asin}/`),
    rel: 'nofollow sponsored',
    principal: true,
  });
}
if (urlWorten) {
  botoes.push({
    rotulo: 'Ver na Worten',
    url: urlWorten,
    rel: 'nofollow noopener',
    principal: loja === 'worten',
  });
}
if (urlWook) {
  botoes.push({
    rotulo: 'Ver na Wook',
    url: linkWook(urlWook),
    rel: 'nofollow sponsored',
    principal: loja === 'wook',
  });
}
if (loja !== 'amazon' && asin) {
  botoes.push({
    rotulo: 'Comparar na Amazon.es',
    url: urlAfiliado(`https://www.amazon.es/dp/${asin}/`),
    rel: 'nofollow sponsored',
    principal: false,
  });
}
botoes.sort((a, b) => Number(b.principal) - Number(a.principal));

const numAvaliacoesFmt = numAvaliacoes?.toLocaleString('pt-PT');

// Os parágrafos do comentário separam-se por linhas em branco no YAML.
const paragrafos = comentario.trim().split(/\n\s*\n/).filter(Boolean);
---

<article class="not-prose my-10 overflow-hidden rounded-2xl border border-marinho-100 bg-creme-50 shadow-sm transition-shadow hover:shadow-md">
  <div class="grid gap-6 p-6 sm:grid-cols-[auto_1fr] sm:gap-8 sm:p-8">
    {imgSrc && (
      <figure class="relative mx-auto w-36 shrink-0 sm:mx-0 sm:w-44">
        <div
          class="absolute -inset-4 rounded-full opacity-40 blur-xl"
          aria-hidden="true"
          style="background: radial-gradient(ellipse at center, rgba(249, 126, 7, 0.20) 0%, rgba(20, 110, 180, 0.15) 50%, transparent 75%);"
        />
        <img
          src={imgSrc}
          alt={nome}
          loading="lazy"
          decoding="async"
          width="220"
          height="220"
          class="relative block h-auto w-full object-contain"
          style="mix-blend-mode: multiply; filter: drop-shadow(0 8px 14px rgba(15,26,36,0.18));"
          referrerpolicy="no-referrer-when-downgrade"
          onerror="this.parentElement.style.display='none'"
        />
      </figure>
    )}

    <div class="flex flex-col">
      <div class="flex flex-wrap items-center gap-2">
        {total > 1 && (
          <span class="text-xs font-semibold uppercase tracking-wider text-marca-600">
            Produto {numero} de {total}
          </span>
        )}
        {etiqueta && (
          <span class="rounded-full bg-marca-100 px-2.5 py-0.5 text-xs font-bold text-marca-700">
            {etiqueta}
          </span>
        )}
      </div>
      <h2 class="mt-2 text-2xl font-bold leading-tight text-marinho-900" style="font-family: var(--font-serif); letter-spacing: -0.02em;">
        {nome}
      </h2>

      {(precoEur != null || classificacao != null) && (
        <div class="mt-3 rounded-xl border border-marinho-100 bg-white/70 p-4">
          {precoEur != null && (
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-3xl font-bold text-marca-700">{formatarPreco(precoEur)}</span>
              {precoAnteriorEur != null && (
                <span class="text-base text-marinho-400 line-through">{formatarPreco(precoAnteriorEur)}</span>
              )}
            </div>
          )}
          {classificacao != null && (
            <p class="mt-1.5 text-sm text-marinho-600">
              <span aria-hidden="true">★</span> {classificacao.toLocaleString('pt-PT')} em 5
              {numAvaliacoesFmt && <> · {numAvaliacoesFmt} avaliações</>}
              {' '}na {NOME_LOJA[loja]}
            </p>
          )}
          {precoData && (
            <p class="mt-1.5 text-xs text-marinho-400">
              Preço confirmado na {NOME_LOJA[loja]} a {formatarData(precoData)}. Pode ter mudado
              entretanto, o valor que conta é o da loja ao abrir o link.
            </p>
          )}
        </div>
      )}

      <div class="mt-4 space-y-3 text-marinho-700 leading-relaxed">
        {paragrafos.map((p) => <p>{p}</p>)}
      </div>

      {botoes.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-3">
          {botoes.map((b) => (
            <a
              href={b.url}
              rel={b.rel}
              class={
                b.principal
                  ? 'inline-flex items-center gap-2 rounded-lg bg-marinho-900 px-4 py-2.5 text-sm font-semibold text-creme-50 transition-colors hover:bg-marca-700'
                  : 'inline-flex items-center gap-2 rounded-lg border border-marinho-900 px-4 py-2.5 text-sm font-semibold text-marinho-900 transition-colors hover:bg-marinho-900 hover:text-creme-50'
              }
            >
              {b.rotulo}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>
