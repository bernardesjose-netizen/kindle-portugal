---
import { Image } from 'astro:assets';
import BotaoAmazon from '@components/afiliados/BotaoAmazon.astro';
import BotaoWorten from '@components/afiliados/BotaoWorten.astro';
import type { OfertaBlackFriday } from '@lib/black-friday-2026';
import { formatarData } from '@lib/formatters';
import { urlAfiliado } from '@lib/afiliados';
import { linkWorten } from '@lib/worten';

interface Props {
  oferta: OfertaBlackFriday;
  carregarFoto?: 'eager' | 'lazy';
}

const { oferta, carregarFoto = 'lazy' } = Astro.props;
const { alternativa, detalhe, etiqueta, expiraEm, id, imagem, linkAfiliado, loja, nome, nomeLoja, preco, referencia, url, verificadaEm } = oferta;
const mostrarPreco = loja !== 'amazon' && Boolean(preco);
const rotulosLojas = { amazon: 'Amazon.es', worten: 'Worten', outra: 'Outra loja' };
const etiquetaLoja = nomeLoja ?? rotulosLojas[loja];
const hrefPrincipal = linkAfiliado ?? (
  loja === 'amazon' ? urlAfiliado(url) : loja === 'worten' ? linkWorten(url) : url
);
const fotoDestino = imagem?.destino;
const hrefImagem = fotoDestino ? fotoDestino.linkAfiliado ?? (
  fotoDestino.loja === 'amazon' ? urlAfiliado(fotoDestino.url)
    : fotoDestino.loja === 'worten' ? linkWorten(fotoDestino.url)
    : fotoDestino.url
) : hrefPrincipal;
const imagemAfiliada = fotoDestino
  ? Boolean(fotoDestino.linkAfiliado) || fotoDestino.loja !== 'outra'
  : Boolean(linkAfiliado) || loja !== 'outra';
const nomeAlternativa = alternativa && (alternativa.nomeLoja ?? rotulosLojas[alternativa.loja]);
const hrefAlternativa = alternativa && (alternativa.linkAfiliado ?? (
  alternativa.loja === 'amazon' ? urlAfiliado(alternativa.url)
    : alternativa.loja === 'worten' ? linkWorten(alternativa.url)
    : alternativa.url
));
const dataVerificacao = new Date(verificadaEm);
const temDataVerificacao = !Number.isNaN(dataVerificacao.valueOf());
---

<li data-oferta-black-friday={id} data-expira-black-friday={expiraEm} class="min-w-0">
  <article class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-marinho-100 bg-creme-50 shadow-sm">
    {imagem && (
      <a
        href={hrefImagem}
        target="_blank"
        rel={imagemAfiliada ? 'sponsored nofollow noopener' : 'noopener'}
        data-afiliado={imagemAfiliada ? (fotoDestino?.nomeLoja ?? nomeLoja ?? fotoDestino?.loja ?? loja).toLowerCase() : undefined}
        class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marca-700"
      >
      <figure class="relative grid aspect-[8/5] place-items-center overflow-hidden bg-white px-5 py-3">
        {typeof imagem.src === 'string' ? (
          <img
            src={imagem.src}
            alt={imagem.alt}
            loading={carregarFoto}
            decoding="async"
            width="440"
            height="275"
            class="h-full max-h-40 w-full object-contain"
            data-fallback="hide-pai"
          />
        ) : (
          <Image
            src={imagem.src}
            alt={imagem.alt}
            loading={carregarFoto}
            decoding="async"
            width={440}
            class="h-full max-h-40 w-full object-contain"
            data-fallback="hide-pai"
          />
        )}
      </figure>
      </a>
    )}
    {imagem?.credito && (
      <p class="px-4 pt-2 text-xs text-marinho-600 sm:px-5">
        {imagem.fonte ? (
          <a href={imagem.fonte} target="_blank" rel="noopener" class="underline underline-offset-2">{imagem.credito}</a>
        ) : imagem.credito}
        {imagem.licenca && (
          <>
            {' · '}
            <a href={imagem.licenca.url} target="_blank" rel="noopener" class="underline underline-offset-2">{imagem.licenca.nome}</a>
          </>
        )}
        {imagem.alteracao && ` · ${imagem.alteracao}`}
      </p>
    )}
    <div class="flex flex-1 flex-col p-4 sm:p-5">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <p class="text-xs font-semibold text-marca-800">{etiquetaLoja}</p>
        {etiqueta && <span class="rounded bg-marinho-100 px-1.5 py-0.5 text-xs font-semibold text-marinho-700">{etiqueta}</span>}
      </div>
      <h3 class="mt-1 text-lg font-bold leading-tight text-marinho-900">{nome}</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-marinho-700">{detalhe}</p>
      {mostrarPreco && (
        <p class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <strong class="text-lg text-marinho-900">{preco}</strong>
          {referencia && <span class="text-xs text-marinho-600">{referencia}</span>}
        </p>
      )}
      {temDataVerificacao && (
        <p class="mt-3 text-xs text-marinho-600">
          Verificado a <time datetime={verificadaEm}>{formatarData(dataVerificacao)}</time>
        </p>
      )}
      <div class="mt-3 flex flex-wrap gap-2">
        {loja === 'amazon' ? (
          <BotaoAmazon url={url}>Consultar na Amazon.es</BotaoAmazon>
        ) : loja === 'worten' ? (
          <BotaoWorten url={url}>Ver na Worten</BotaoWorten>
        ) : (
          <a href={hrefPrincipal} target="_blank" rel={linkAfiliado ? 'sponsored nofollow noopener' : 'noopener'} class="btn-secundario px-4 py-2 text-sm">
            Consultar na {etiquetaLoja} <span aria-hidden="true">↗</span>
          </a>
        )}
        {alternativa && (
          <a
            href={hrefAlternativa}
            target="_blank"
            rel={alternativa.linkAfiliado || alternativa.loja !== 'outra' ? 'sponsored nofollow noopener' : 'noopener'}
            class="inline-flex items-center gap-2 rounded-lg border border-marinho-300 px-4 py-2 text-sm font-semibold text-marinho-900 no-underline hover:bg-marinho-50"
          >
            Ver também em {nomeAlternativa} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </article>
</li>
