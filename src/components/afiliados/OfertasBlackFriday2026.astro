---
import { Image } from 'astro:assets';
import imagemCampanha from '../../assets/imagens/ofertas/leitura-digital-black-friday-2026.png';
import Container from '@components/ui/Container.astro';
import BotaoAmazon from '@components/afiliados/BotaoAmazon.astro';
import BotaoWorten from '@components/afiliados/BotaoWorten.astro';
import CartaoOfertaBlackFriday2026 from '@components/afiliados/CartaoOfertaBlackFriday2026.astro';
import DestaqueBlackWook from '@components/afiliados/DestaqueBlackWook.astro';
import JanelaBlackFriday2026 from '@components/afiliados/JanelaBlackFriday2026.astro';
import { GUIA_BLACK_FRIDAY, type OfertaBlackFriday } from '@lib/black-friday-2026';
import { OFERTAS_BLACK_FRIDAY_2026 } from '@lib/ofertas-black-friday-2026';

interface Props {
  modo: 'entrada' | 'guia';
}
const { modo } = Astro.props;
const entrada = modo === 'entrada';
const agora = Date.now();
const lista: readonly OfertaBlackFriday[] = OFERTAS_BLACK_FRIDAY_2026;
const emCampanha = lista.filter(({ expiraEm }) => !expiraEm || Date.parse(expiraEm) > agora);
const ofertas = entrada ? emCampanha.filter(({ destaque }) => destaque).slice(0, 6) : emCampanha;
const ofertasPrincipais = entrada ? ofertas : ofertas.slice(0, 8);
const ofertasRestantes = ofertas.slice(ofertasPrincipais.length);
const tituloId = entrada ? 'titulo-black-friday-entrada' : 'titulo-ofertas-black-friday';
---

<JanelaBlackFriday2026>
  <section
    id={entrada ? undefined : 'ofertas-black-friday'}
    aria-labelledby={tituloId}
    data-black-friday-ofertas
    class:list={[
      'not-prose scroll-mt-24',
      entrada
        ? 'border-b-4 border-marca-500 bg-gradient-to-br from-marinho-900 via-marinho-800 to-oceano-900 text-creme-50'
        : 'my-8 rounded-2xl border border-marca-200 bg-gradient-to-br from-marca-50 via-creme-50 to-oceano-50 text-marinho-900',
    ]}
  >
    <Container largura={entrada ? 'largo' : 'normal'} classe={entrada ? 'py-8 sm:py-12' : 'py-6'}>
      <div class="relative isolate overflow-hidden rounded-2xl border border-marinho-700 bg-marinho-900 text-creme-50">
        <Image
          src={imagemCampanha}
          alt=""
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 1280px) 680px, (min-width: 640px) 56vw, 65vw"
          loading={entrada ? 'eager' : 'lazy'}
          fetchpriority={entrada ? 'high' : undefined}
          class="absolute inset-y-0 right-0 h-full w-[65%] object-cover object-[60%_70%] sm:w-[56%]"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-marinho-900 via-marinho-900/90 to-marinho-900/20"></div>
        <div class="relative max-w-2xl px-5 py-7 sm:px-8 sm:py-10">
          <h2 id={tituloId} class="text-3xl font-bold leading-tight sm:text-4xl">
            {entrada ? 'Black Friday Kindle 2026' : 'Campanhas Black Friday da Amazon.es e da Worten'}
          </h2>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-oceano-100 sm:text-base">
            Kindle, Kobo e acessórios na Amazon.es, na Worten, na FNAC e noutras lojas com entrega em Portugal.
          </p>
          {entrada && (
            <a href={GUIA_BLACK_FRIDAY} class="btn-marca mt-5 w-fit px-6 py-3.5 text-base">
              {'Guia Black Friday Kindle' + (emCampanha.length ? ' · ver as ' + emCampanha.length + ' ofertas' : '')} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      <ul aria-label="Campanhas das lojas" class="mt-4 grid gap-3 md:grid-cols-2">
        <li class="flex min-w-0 flex-col rounded-2xl border border-marca-200 border-t-4 border-t-marca-500 bg-creme-50 p-4 text-marinho-900 sm:p-5">
          <h3 class="text-xl font-bold">Amazon.es</h3>
          <p class="mt-1 text-sm font-semibold text-marinho-800">Semana Black Friday de 19 a 30 de novembro</p>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-marinho-700">
            Há ofertas antecipadas em Kindle selecionados desde 16 de novembro. Confirma a versão e a entrega para a tua morada.
          </p>
          <div class="mt-4">
            <BotaoAmazon url="https://www.amazon.es/blackfriday" tamanho="grande">Ver Black Friday na Amazon.es</BotaoAmazon>
          </div>
        </li>

        <li class="flex min-w-0 flex-col rounded-2xl border border-marinho-200 border-t-4 border-t-[#e3001b] bg-creme-50 p-4 text-marinho-900 sm:p-5">
          <h3 class="text-xl font-bold">Worten</h3>
          <p class="mt-1 text-sm font-semibold text-marinho-800">Black Friday em Portugal</p>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-marinho-700">
            Em 24 de novembro, o Kindle de 6″ e 16 GB com publicidade custava 124,99 € na Worten em grafite ou roxo. Confirma o total para a tua morada.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <BotaoWorten url="https://www.worten.pt/black-friday" tamanho="grande">Ver Black Friday na Worten</BotaoWorten>
            <a href="/blog/vale-a-pena-usar-o-talao-worten-no-presente-de-natal-2026" class="text-sm font-semibold text-marinho-800 underline underline-offset-2">Já tens talão? Consulta os prazos</a>
          </div>
        </li>
      </ul>
      <DestaqueBlackWook />
      <p class:list={['mt-3 text-xs', entrada ? 'text-creme-100' : 'text-marinho-600']}>Publicidade · Ligações de afiliado</p>

      {!entrada && ofertas.length > 0 && (
        <h3 class="mt-6 text-xl font-bold text-marinho-900">Ofertas de Kindle, Kobo e acessórios</h3>
      )}
      {ofertas.length > 0 && (
        <ul class:list={['mt-5 grid gap-4 sm:grid-cols-2', entrada ? 'lg:grid-cols-3' : 'xl:grid-cols-2']}>
          {ofertasPrincipais.map((oferta) => (
            <CartaoOfertaBlackFriday2026 oferta={oferta} />
          ))}
        </ul>
      )}
      {!entrada && ofertasRestantes.length > 0 && (
        <details class="group mt-5 rounded-xl border border-marinho-200 bg-white/70">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-semibold text-marinho-900 marker:content-none sm:px-5">
            <span>Ver mais {ofertasRestantes.length} ofertas</span>
            <span aria-hidden="true" class="text-xl text-marca-700 transition-transform group-open:rotate-45">+</span>
          </summary>
          <ul class="grid gap-4 border-t border-marinho-100 p-4 sm:grid-cols-2 xl:grid-cols-2">
            {ofertasRestantes.map((oferta) => (
              <CartaoOfertaBlackFriday2026 oferta={oferta} />
            ))}
          </ul>
        </details>
      )}
      {ofertas.length > 0 && (
        <p class:list={['mt-3 text-xs', entrada ? 'text-creme-100' : 'text-marinho-600']}>Publicidade · Ligações de afiliado</p>
      )}

    </Container>
  </section>
</JanelaBlackFriday2026>

<script>
  function ocultarOfertasExpiradas() {
    const agora = Date.now();
    document.querySelectorAll<HTMLElement>('[data-expira-black-friday]').forEach((oferta) => {
      const fim = Date.parse(oferta.dataset.expiraBlackFriday ?? '');
      if (Number.isFinite(fim)) oferta.hidden = fim <= agora;
    });
  }
  ocultarOfertasExpiradas();
  if (document.querySelector('[data-expira-black-friday]')) {
    window.setInterval(ocultarOfertasExpiradas, 60000);
  }
</script>
