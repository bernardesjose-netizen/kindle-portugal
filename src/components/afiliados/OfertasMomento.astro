---
/**
 * Grelha com as ofertas do momento (desconto de 35 % ou mais, qualquer
 * categoria), lidas de `src/lib/ofertas-momento.ts`.
 *
 * Cada cartão tem a data de expiração em `data-expira`; um pequeno script
 * esconde no browser as ofertas que já passaram, e a secção inteira quando
 * não sobra nenhuma. Assim, num site estático que só reconstrói quando há
 * alterações, não ficam ofertas caducadas à vista.
 */
import Container from '@components/ui/Container.astro';
import AvisoAppAmazon from '@components/afiliados/AvisoAppAmazon.astro';
import { ofertasRecentes, expiraEm, DESCONTO_MINIMO, type OfertaMomento } from '@lib/ofertas-momento';
import { imagemParaAsin } from '@lib/asin-images';
import { urlAfiliado } from '@lib/afiliados';
import { formatarPreco, formatarData, formatarHora } from '@lib/formatters';

interface Props {
  /** Número máximo de cartões. */
  limite?: number;
  /** Mostrar o link "Ver todas" para /promocoes. */
  verTodas?: boolean;
  classe?: string;
  /**
   * Outra lista e outros textos (ex.: tablets e telemóveis). Sem isto, mostra
   * as ofertas de 35 % ou mais de `ofertasRecentes()`.
   */
  lista?: OfertaMomento[];
  pill?: string;
  titulo?: string;
  texto?: string;
  /** id do título, para âncoras e aria-labelledby. */
  idTitulo?: string;
}

const {
  limite,
  verTodas = false,
  classe = '',
  lista,
  pill = 'Ofertas do momento',
  titulo = `Grandes marcas com ${DESCONTO_MINIMO} % ou mais de desconto`,
  texto = 'Fora do mundo Kindle, mas escolhidas com o mesmo critério: marcas conhecidas, vendidas e enviadas pela Amazon, em stock, com 4 estrelas ou mais e o desconto que a própria ficha mostra.',
  idTitulo = 'ofertas-momento-titulo',
} = Astro.props;

const agora = Date.now();
const todas = (lista ?? ofertasRecentes()).filter((o) => expiraEm(o).valueOf() > agora);
const ofertas = limite ? todas.slice(0, limite) : todas;
// Só conta como verificação o que foi lido por nós na ficha (sem `fonte`).
const ultima = todas.find((o) => !o.fonte)?.verificado_em;
const estrelas = (n: number) => n.toLocaleString('pt-PT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

{ofertas.length > 0 && (
  <section
    class={`border-y border-marca-200/70 bg-gradient-to-br from-marca-50 via-creme-50 to-dourado-50/60 ${classe}`}
    aria-labelledby={idTitulo}
    data-ofertas-raiz
  >
    <Container largura="normal" classe="py-14">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="pill">{pill}</span>
          <h2
            id={idTitulo}
            class="mt-3 text-3xl font-bold text-marinho-900 md:text-4xl"
            style="letter-spacing: -0.025em;"
          >
            {titulo}
          </h2>
          <p class="mt-2 max-w-2xl text-marinho-600">
            {texto}
            {ultima && (
              <>
                {' '}Última verificação a {formatarData(ultima)}, às {formatarHora(ultima)}.
              </>
            )}
          </p>
        </div>
        {verTodas && todas.length > ofertas.length && (
          <a href="/promocoes#ofertas-momento-titulo" class="shrink-0 text-sm font-semibold text-marca-600 hover:text-marca-700">
            Ver as {todas.length} ofertas →
          </a>
        )}
      </div>

      <AvisoAppAmazon classe="mb-4" />

      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {ofertas.map((o) => {
          const img = imagemParaAsin(o.asin, 500);
          return (
            <li
              class="caixa group relative flex flex-col overflow-hidden bg-white/90 p-5"
              data-oferta
              data-expira={expiraEm(o).toISOString()}
            >
              <span class="absolute right-3 top-3 z-10 rounded-full bg-marca-600 px-2.5 py-1 text-sm font-bold text-white shadow-sm">
                −{o.desconto_pct}%
              </span>
              {img && (
                <div class="flex h-32 items-center justify-center" aria-hidden="true">
                  <img
                    src={img}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="140"
                    height="140"
                    class="block max-h-32 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
                    style="mix-blend-mode: multiply;"
                    referrerpolicy="no-referrer-when-downgrade"
                    data-fallback="hide"
                  />
                </div>
              )}
              <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span class="rounded-md bg-marinho-900 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-creme-50">
                  {o.marca}
                </span>
                <span class="text-xs font-semibold uppercase tracking-wider text-marinho-400">
                  {o.categoria}{o.so_prime ? ' · só Prime' : ''}
                </span>
              </p>
              <h3 class="mt-2 text-base font-bold leading-snug text-marinho-900" style="font-family: var(--font-serif);">
                {o.nome}
              </h3>
              <p class="mt-2 flex flex-wrap items-baseline gap-x-2">
                <span class="text-2xl font-bold text-marca-700">{formatarPreco(o.preco_eur)}</span>
                <span class="text-sm text-marinho-400 line-through">{formatarPreco(o.preco_recomendado_eur)}</span>
              </p>
              {o.referencia === 'minimo-30-dias' && (
                <p class="text-[0.7rem] text-marinho-400">riscado: preço mais baixo dos últimos 30 dias</p>
              )}
              {o.classificacao != null && o.num_avaliacoes != null && (
                <p class="mt-1 text-xs text-marinho-500">
                  <span aria-hidden="true" class="text-dourado-500">★</span> {estrelas(o.classificacao)} · {o.num_avaliacoes.toLocaleString('pt-PT')} avaliações
                </p>
              )}
              {o.fonte && (
                <p class="mt-2 rounded-lg bg-ambar-50 px-2 py-1.5 text-[0.7rem] leading-snug text-ambar-800">
                  Preço por confirmar na ficha: anunciado a {o.fonte.preco_original} por{' '}
                  <a href={o.fonte.url} rel="noopener" target="_blank" class="underline underline-offset-2">{o.fonte.nome}</a>;
                  em Portugal a Amazon cobra IVA de 23 %, daí o valor acima.
                </p>
              )}
              <p class="mt-3 flex-1 text-sm text-marinho-600">{o.resumo}</p>
              <a
                href={urlAfiliado(`https://www.amazon.es/dp/${o.asin}`)}
                rel="sponsored nofollow noopener"
                target="_blank"
                data-afiliado="amazon"
                data-mercado="es"
                class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-lg bg-marinho-900 px-4 py-2 text-sm font-semibold text-creme-50 transition-all hover:-translate-y-0.5 hover:bg-marca-600"
              >
                Ver na Amazon.es
                <span aria-hidden="true">↗</span>
              </a>
              <p class="mt-2 text-center text-[0.7rem] text-marinho-400">
                {o.fonte ? 'Anunciado' : 'Preço'} a {formatarData(o.verificado_em)}, às {formatarHora(o.verificado_em)}
              </p>
            </li>
          );
        })}
      </ul>

      <p class="mt-6 text-xs text-marinho-500">
        Preços com IVA, como a Amazon.es os cobra com entrega em Portugal. Mudam a qualquer
        momento e as ofertas podem esgotar: o valor que conta é o da ficha ao abrir o link.
      </p>
    </Container>
  </section>
)}

<script>
  // Script processado pelo Astro (ficheiro externo em /assets/): a CSP do site
  // (public/_headers) bloqueia scripts escritos dentro da página.
  // Caduca todos os cartões de oferta da página (esta secção e os do destaque
  // da campanha) e esconde a secção quando não sobra nenhum.
  function limpar() {
    const agora = Date.now();
    document.querySelectorAll<HTMLElement>('[data-oferta]').forEach((cartao) => {
      const expira = Date.parse(cartao.getAttribute('data-expira') ?? '');
      cartao.hidden = !isNaN(expira) && agora > expira;
    });
    document.querySelectorAll<HTMLElement>('[data-ofertas-raiz]').forEach((raiz) => {
      raiz.hidden = raiz.querySelectorAll('[data-oferta]:not([hidden])').length === 0;
    });
  }

  limpar();
  setInterval(limpar, 60000);
</script>
