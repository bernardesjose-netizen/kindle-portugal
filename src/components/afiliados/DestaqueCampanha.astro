---
/**
 * Destaque grande da campanha em curso, para o topo da página de entrada.
 *
 * Aparece acima do herói, logo é a primeira coisa visível sem rolar. Só é
 * gerado se a campanha estiver visível no build (antecipação ou a decorrer),
 * e o script FasesCampanha troca os textos e as contagens no browser: antes da
 * abertura conta até ao início, durante a campanha conta até ao fim, e depois
 * do fim o bloco desaparece, mesmo que o site não volte a ser reconstruído.
 *
 * Mostra apenas Kindle com `preco_promo` confirmado e que não estejam
 * esgotados: nunca anuncia um desconto que não tenha sido verificado na
 * Amazon (regra do CLAUDE.md). Os restantes aparecem numa linha com o estado
 * do stock.
 */
import Container from '@components/ui/Container.astro';
import LinkPrecos from '@components/afiliados/LinkPrecos.astro';
import LinkAvaliacoes from '@components/afiliados/LinkAvaliacoes.astro';
import ContagemDecrescente from '@components/afiliados/ContagemDecrescente.astro';
import EstadoStock from '@components/afiliados/EstadoStock.astro';
import FasesCampanha from '@components/afiliados/FasesCampanha.astro';
import OfertaEstrela from '@components/afiliados/OfertaEstrela.astro';
import { getCollection } from 'astro:content';
import { CAMPANHA, campanhaVisivel, faseCampanha, horaFimPortugal } from '@lib/promocoes';
import { formatarPreco, formatarData } from '@lib/formatters';
import { imagemParaAsin } from '@lib/asin-images';
import { urlAfiliado } from '@lib/afiliados';
import type { Disponibilidade } from '@lib/disponibilidade';
import { ofertasRecentes, expiraEm, ofertasEstrelaPorMostrar, MARCAS_PRIORITARIAS_GRELHA } from '@lib/ofertas-momento';

const visivel = campanhaVisivel();
const fase = faseCampanha();

type Destaque = {
  slug: string;
  nome: string;
  asin: string | undefined;
  preco_promo: number;
  preco_normal: number | null;
  desconto_pct: number | null;
  disponibilidade: Disponibilidade | undefined;
};

type EstadoModelo = {
  slug: string;
  nome: string;
  disponibilidade: Disponibilidade;
  data: Date | undefined;
};

let destaques: Destaque[] = [];
let estados: EstadoModelo[] = [];

if (visivel) {
  const modelos = await getCollection('modelos', ({ data }) => !data.rascunho);
  for (const it of CAMPANHA.itens) {
    const m = modelos.find((x) => x.id === it.slug);
    if (!m) continue;
    if (m.data.disponibilidade) {
      estados.push({
        slug: it.slug,
        nome: m.data.nome,
        disponibilidade: m.data.disponibilidade,
        data: m.data.disponibilidade_data,
      });
    }
    if (it.preco_promo != null && m.data.disponibilidade !== 'esgotado') {
      destaques.push({
        slug: it.slug,
        nome: m.data.nome,
        asin: m.data.asin,
        preco_promo: it.preco_promo,
        preco_normal: it.preco_normal ?? m.data.preco_referencia_eur ?? null,
        desconto_pct: it.desconto_pct,
        disponibilidade: m.data.disponibilidade,
      });
    }
  }
}

const principal = destaques[0];
// Quatro cartões, por esta ordem de prioridade: Kindle com desconto e stock,
// o produto extra escolhido (CAMPANHA.extras) e, para completar, as ofertas de
// grandes marcas com maior desconto (src/lib/ofertas-momento.ts).
const TOTAL_CARTOES = 4;
// O Kindle que está no destaque principal (OfertaEstrela) não se repete na grelha.
const agoraEstrela = Date.now();
const asinsEstrela = new Set(
  ofertasEstrelaPorMostrar()
    .filter((o) => !o.mostrar_desde || o.mostrar_desde.valueOf() <= agoraEstrela)
    .map((o) => o.asin)
);
const cartoesKindle = destaques.filter((d) => !d.asin || !asinsEstrela.has(d.asin)).slice(0, TOTAL_CARTOES);
const novidades = CAMPANHA.novidades.slice(0, Math.max(0, TOTAL_CARTOES - cartoesKindle.length));
const agoraMs = Date.now();
const marcasValidas = ofertasRecentes()
  .filter((o) => expiraEm(o).valueOf() > agoraMs)
  .sort((a, b) => b.desconto_pct - a.desconto_pct);
// Cartão das ofertas flash da Fiesta Prime (página de eventos da Amazon.es),
// pedido pelo utilizador a 07/10 no lugar dos auriculares. Sai com a campanha.
const OFERTAS_FLASH = {
  url: urlAfiliado('https://www.amazon.es/fiestaprime'),
  ate: CAMPANHA.fim,
};
const mostrarFlash = OFERTAS_FLASH.ate.valueOf() > agoraMs;
// As marcas prioritárias (ex.: a que saiu do destaque principal) passam à
// frente do produto extra e das restantes ofertas.
const vagas = Math.max(0, TOTAL_CARTOES - cartoesKindle.length - novidades.length - (mostrarFlash ? 1 : 0));
const marcasPrioritarias = marcasValidas.filter((o) => MARCAS_PRIORITARIAS_GRELHA.includes(o.asin)).slice(0, vagas);
const extras = CAMPANHA.extras.slice(0, vagas - marcasPrioritarias.length);
const cartoesMarcas = [
  ...marcasPrioritarias,
  ...marcasValidas
    .filter((o) => !MARCAS_PRIORITARIAS_GRELHA.includes(o.asin))
    .slice(0, vagas - marcasPrioritarias.length - extras.length),
];
const esgotados = estados.filter((e) => e.disponibilidade === 'esgotado');

// "Kindle (básico)" → "básico", "Kindle Paperwhite" → "Paperwhite".
const nomeCurto = (nome: string) => nome.replace(/^Kindle\s*/, '').replace(/[()]/g, '').trim();
const maiuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const listaEsgotados = esgotados
  .map((e) => `o ${nomeCurto(e.nome)}`)
  .join(', ')
  .replace(/, ([^,]*)$/, ' e $1');

// "6 e 7 de outubro", construído a partir das datas da campanha.
const janela = `${new Intl.DateTimeFormat('pt-PT', { day: 'numeric' }).format(CAMPANHA.inicio)} e ${new Intl.DateTimeFormat(
  'pt-PT',
  { day: 'numeric', month: 'long' }
).format(CAMPANHA.fim)}`;
const diaFim = new Intl.DateTimeFormat('pt-PT', { day: 'numeric', month: 'long', timeZone: 'Europe/Lisbon' }).format(CAMPANHA.fim);

// Se o Kindle principal já está no destaque grande, o título não o repete.
const principalNoDestaque = !!principal?.asin && asinsEstrela.has(principal.asin);
const titulo = principal && !principalNoDestaque
  ? `${principal.nome} a ${formatarPreco(principal.preco_promo)}${principal.desconto_pct ? `, −${principal.desconto_pct}%` : ''}`
  : principalNoDestaque
    ? 'Paperwhite de volta e o novo Kindle já em stock'
    : 'Kindle em promoção';
---

{visivel && (principal || novidades.length > 0 || extras.length > 0) && (
  <section
    class="relative overflow-hidden border-b-4 border-marca-600 bg-gradient-to-br from-marca-700 via-marca-600 to-marinho-900 text-creme-50"
    aria-labelledby="destaque-campanha-titulo"
    data-campanha-antecipacao={CAMPANHA.antecipacao.toISOString()}
    data-campanha-inicio={CAMPANHA.inicio.toISOString()}
    data-campanha-fim={CAMPANHA.fim.toISOString()}
    data-esconder-fora
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(ellipse at top left, rgb(255 188 74 / 0.30) 0%, transparent 55%), radial-gradient(ellipse at bottom right, rgb(15 26 36 / 0.45) 0%, transparent 60%);"
    />

    <Container largura="normal" classe="relative z-10 py-8 sm:py-10">
      {/* Oferta estrela, em largura total: a primeira coisa à vista. */}
      <OfertaEstrela tema="escuro" classe="mb-8" />

      <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
        {/* Lado esquerdo: mensagem e contagem */}
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-creme-50/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-creme-50 ring-1 ring-inset ring-creme-50/30">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-creme-50 opacity-75" data-so-fase="ativa" hidden={fase !== 'ativa'}></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-creme-50"></span>
            </span>
            <span>
              {CAMPANHA.etiqueta} ·{' '}
              <span data-so-fase="ativa" hidden={fase !== 'ativa'}>a decorrer até {diaFim}, às {horaFimPortugal()}</span>
              <span data-so-fase="antecipacao" hidden={fase !== 'antecipacao'}>{janela}</span>
            </span>
          </span>

          <h2
            id="destaque-campanha-titulo"
            class="mt-4 text-[1.75rem] font-bold leading-[1.1] sm:text-4xl"
            style="letter-spacing: -0.03em; font-family: var(--font-serif);"
          >
            {titulo}
          </h2>

          <p class="mt-3 max-w-xl text-creme-50/90" data-so-fase="ativa" hidden={fase !== 'ativa'}>
            {destaques.length === 1 && esgotados.length > 0
              ? `É o único Kindle com stock e desconto na Amazon.es neste momento: ${listaEsgotados} ${esgotados.length === 1 ? 'esgotou' : 'esgotaram'}.${novidades.length > 0 ? ' O novo Kindle básico de 2026 já está em stock, sem desconto.' : ''} Preços confirmados por nós, com data.`
              : 'Campanha reservada a membros Prime. Preços confirmados por nós, com data.'}
          </p>
          <p class="mt-3 max-w-xl text-creme-50/90" data-so-fase="antecipacao" hidden={fase !== 'antecipacao'}>
            Não é preciso esperar pela abertura. A Amazon já libertou parte das ofertas, e estas
            foram confirmadas por nós.
          </p>

          <div data-so-fase="antecipacao" hidden={fase !== 'antecipacao'}>
            <ContagemDecrescente
              alvo={CAMPANHA.inicio}
              etiqueta="Abre dentro de"
              mensagem_fim="Já abriu. Vê os preços do momento na Amazon."
              tema="escuro"
              classe="mt-6"
            />
          </div>
          <div data-so-fase="ativa" hidden={fase !== 'ativa'}>
            <ContagemDecrescente
              alvo={CAMPANHA.fim}
              etiqueta="Termina dentro de"
              mensagem_fim="A campanha terminou."
              tema="escuro"
              classe="mt-6"
            />
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/promocoes"
              class="inline-flex items-center gap-2 rounded-[0.625rem] bg-creme-50 px-5 py-3 font-bold text-marinho-900 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-white hover:shadow-md"
            >
              Ver todas as promoções
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="/guias/prime-big-deal-days-2026"
              class="inline-flex items-center gap-2 rounded-[0.625rem] border border-creme-50/40 bg-creme-50/10 px-5 py-3 font-semibold text-creme-50 backdrop-blur transition hover:-translate-y-0.5 hover:border-creme-50/70 hover:bg-creme-50/20"
            >
              Como aproveitar sem pagar Prime
            </a>
          </div>
        </div>

        {/* Lado direito: Kindle com desconto confirmado + extra */}
        <ul class="grid gap-3 sm:grid-cols-2">
          {cartoesKindle.map((d) => {
            const img = d.asin ? imagemParaAsin(d.asin, 250) : null;
            return (
              <li class="rounded-2xl border border-creme-50/25 bg-marinho-900/35 p-4 backdrop-blur-sm">
                <a href={`/modelos/${d.slug}`} class="group block">
                  <div class="flex items-center gap-3">
                    {img && (
                      <img
                        src={img}
                        alt=""
                        loading="eager"
                        decoding="async"
                        width="56"
                        height="56"
                        class="h-14 w-14 shrink-0 rounded-lg bg-creme-50 object-contain p-1"
                        style="mix-blend-mode: multiply;"
                        referrerpolicy="no-referrer-when-downgrade"
                        data-fallback="hide"
                      />
                    )}
                    <div class="min-w-0">
                      <p class="text-sm font-bold leading-snug text-creme-50 transition-colors group-hover:text-dourado-300">
                        {d.nome}
                      </p>
                      <p class="mt-1 flex flex-wrap items-center gap-1.5">
                        {d.desconto_pct != null && (
                          <span class="inline-block rounded bg-dourado-400 px-1.5 py-0.5 text-[0.7rem] font-bold text-marinho-900">
                            −{d.desconto_pct}%
                          </span>
                        )}
                        {d.disponibilidade === 'ultimas-unidades' && (
                          <span class="inline-block rounded bg-ambar-100 px-1.5 py-0.5 text-[0.7rem] font-bold text-ambar-800">
                            Últimas unidades
                          </span>
                        )}
                      </p>
                    </div>
                  </div>

                  <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
                    <span class="text-2xl font-bold text-creme-50">{formatarPreco(d.preco_promo)}</span>
                    {d.preco_normal != null && (
                      <span class="text-sm text-creme-50/60 line-through">{formatarPreco(d.preco_normal)}</span>
                    )}
                  </p>
                </a>

                {d.asin && (
                  <a
                    href={urlAfiliado(`https://www.amazon.es/dp/${d.asin}`)}
                    rel="sponsored nofollow noopener"
                    target="_blank"
                    data-afiliado="amazon"
                    data-mercado="es"
                    class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-creme-50/15 px-3 py-2 text-xs font-bold text-creme-50 ring-1 ring-inset ring-creme-50/25 transition-all hover:bg-creme-50 hover:text-marinho-900"
                  >
                    Ver na Amazon.es
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            );
          })}

          {/* Novidades Kindle (sem desconto) e o produto extra, com o mesmo cartão. */}
          {[...novidades, ...extras].map((x) => {
            const img = imagemParaAsin(x.asin, 250);
            return (
              <li class="rounded-2xl border border-dourado-300/50 bg-marinho-900/45 p-4 backdrop-blur-sm">
                <p class="text-[0.7rem] font-bold uppercase tracking-wider text-dourado-300">{x.etiqueta}</p>
                <div class="mt-2 flex items-center gap-3">
                  {img && (
                    <img
                      src={img}
                      alt=""
                      loading="eager"
                      decoding="async"
                      width="56"
                      height="56"
                      class="h-14 w-14 shrink-0 rounded-lg bg-creme-50 object-contain p-1"
                      style="mix-blend-mode: multiply;"
                      referrerpolicy="no-referrer-when-downgrade"
                      data-fallback="hide"
                    />
                  )}
                  <div class="min-w-0">
                    <p class="text-sm font-bold leading-snug text-creme-50">{x.nome}</p>
                    <LinkAvaliacoes asin={x.asin} tema="escuro" classe="mt-1 text-[0.7rem]" />
                  </div>
                </div>
                <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
                  <span class="text-2xl font-bold text-creme-50">{formatarPreco(x.preco_eur)}</span>
                  {x.desconto_pct != null && (
                    <span class="inline-block rounded bg-dourado-400 px-1.5 py-0.5 text-[0.7rem] font-bold text-marinho-900">
                      −{x.desconto_pct}%
                    </span>
                  )}
                </p>
                {x.preco_comparacao_eur != null && (
                  <p class="mt-1 text-[0.7rem] text-creme-50/70">
                    face a {formatarPreco(x.preco_comparacao_eur)}{x.origem_comparacao ? `, ${x.origem_comparacao}` : ''}
                  </p>
                )}
                <a
                  href={urlAfiliado(`https://www.amazon.es/dp/${x.asin}`)}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  data-afiliado="amazon"
                  data-mercado="es"
                  class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-creme-50/15 px-3 py-2 text-xs font-bold text-creme-50 ring-1 ring-inset ring-creme-50/25 transition-all hover:bg-creme-50 hover:text-marinho-900"
                >
                  Ver na Amazon.es
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            );
          })}

          {/* Ofertas flash da Fiesta Prime: um link para a página do evento. */}
          {mostrarFlash && (
            <li
              class="flex flex-col rounded-2xl border-2 border-dourado-400 bg-gradient-to-br from-dourado-400/25 to-marinho-900/50 p-4 backdrop-blur-sm"
              data-oferta
              data-expira={OFERTAS_FLASH.ate.toISOString()}
            >
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-dourado-300">
                <span aria-hidden="true">⚡</span> Ofertas flash · Fiesta Prime
              </p>
              <p class="mt-2 text-base font-bold leading-snug text-creme-50" style="font-family: var(--font-serif);">
                Todas as ofertas relâmpago da Amazon.es
              </p>
              <p class="mt-2 flex-1 text-xs leading-relaxed text-creme-50/85">
                Descontos de poucas horas em todas as categorias, para membros Prime, até ao fim da
                campanha às {horaFimPortugal()}. Mudam a cada momento: vê-os direto na Amazon.es.
              </p>
              <a
                href={OFERTAS_FLASH.url}
                rel="sponsored nofollow noopener"
                target="_blank"
                data-afiliado="amazon"
                data-mercado="es"
                class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-dourado-400 px-3 py-2 text-xs font-bold text-marinho-900 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-marca-300"
              >
                Ver as ofertas flash
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          )}

          {/* Grandes marcas: caducam no browser como na secção Ofertas do momento. */}
          {cartoesMarcas.map((o) => {
            const img = imagemParaAsin(o.asin, 250);
            return (
              <li class="rounded-2xl border border-creme-50/25 bg-marinho-900/35 p-4 backdrop-blur-sm" data-oferta data-expira={expiraEm(o).toISOString()}>
                <p class="flex flex-wrap items-center gap-1.5 text-[0.7rem] font-bold uppercase tracking-wider">
                  <span class="rounded bg-creme-50 px-1.5 py-0.5 text-marinho-900">{o.marca}</span>
                  <span class="text-creme-50/70">{o.categoria}</span>
                </p>
                <div class="mt-2 flex items-center gap-3">
                  {img && (
                    <img
                      src={img}
                      alt=""
                      loading="eager"
                      decoding="async"
                      width="56"
                      height="56"
                      class="h-14 w-14 shrink-0 rounded-lg bg-creme-50 object-contain p-1"
                      style="mix-blend-mode: multiply;"
                      referrerpolicy="no-referrer-when-downgrade"
                      data-fallback="hide"
                    />
                  )}
                  <div class="min-w-0">
                    <p class="text-sm font-bold leading-snug text-creme-50">{o.nome}</p>
                    <LinkAvaliacoes asin={o.asin} tema="escuro" classe="mt-1 text-[0.7rem]" />
                  </div>
                </div>
                <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
                  <span class="text-2xl font-bold text-creme-50">{formatarPreco(o.preco_eur)}</span>
                  <span class="text-sm text-creme-50/60 line-through">{formatarPreco(o.preco_recomendado_eur)}</span>
                  <span class="inline-block rounded bg-dourado-400 px-1.5 py-0.5 text-[0.7rem] font-bold text-marinho-900">−{o.desconto_pct}%</span>
                </p>
                <a
                  href={urlAfiliado(`https://www.amazon.es/dp/${o.asin}`)}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  data-afiliado="amazon"
                  data-mercado="es"
                  class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-creme-50/15 px-3 py-2 text-xs font-bold text-creme-50 ring-1 ring-inset ring-creme-50/25 transition-all hover:bg-creme-50 hover:text-marinho-900"
                >
                  Ver na Amazon.es
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      {estados.length > 0 && (
        <div class="mt-6 rounded-xl border border-creme-50/20 bg-marinho-900/30 p-3 text-sm">
          <p class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-creme-50/70">
              Stock na Amazon.es{CAMPANHA.verificado_em ? ` a ${formatarData(CAMPANHA.verificado_em)}` : ''}
            </span>
            {estados.map((e) => (
              <a href={`/modelos/${e.slug}`} class="inline-flex items-center gap-2 text-creme-50 hover:text-dourado-300">
                <span class="font-semibold">{maiuscula(nomeCurto(e.nome))}</span>
                <EstadoStock estado={e.disponibilidade} data={e.data} tema="escuro" />
              </a>
            ))}
          </p>
          {esgotados.length > 0 && (
            <p class="mt-2 text-xs text-creme-50/75">
              O Kindle básico de 2026 já está em stock, sem publicidade, a 177,88 €; os restantes modelos de 2026 e os preços estão em{' '}
              <a href="/promocoes" class="font-semibold underline decoration-creme-50/40 underline-offset-2 hover:text-dourado-300">promoções</a>.
            </p>
          )}
        </div>
      )}

      {CAMPANHA.verificado_em && (
        <p class="mt-4 text-xs text-creme-50/70">
          Preços confirmados na Amazon.es a {formatarData(CAMPANHA.verificado_em)}, com IVA e entrega
          para Portugal. Mudam ao minuto e não garantimos disponibilidade: o valor que conta é o da
          ficha ao abrir o link (<LinkPrecos />).
        </p>
      )}
    </Container>
  </section>
)}

<FasesCampanha />
