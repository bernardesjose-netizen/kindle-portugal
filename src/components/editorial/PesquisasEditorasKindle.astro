---
import LinkAmazon from '@components/afiliados/LinkAmazon.astro';
import catalogo from '../../data/editoras-kindle.json';

interface Edicao {
  editora: string;
  editoraAmazon?: string;
  autorPesquisa?: string;
  titulo: string;
  autor: string;
  tradutor?: string;
  asin: string;
  fonte: string;
}

const editoras: Edicao[] = [...catalogo].sort((a, b) => a.editora.localeCompare(b.editora, 'pt'));

function pesquisaKindle(edicao: Edicao) {
  const url = new URL('https://www.amazon.es/s');
  url.searchParams.set('i', 'digital-text');
  // Filtros da loja espanhola para ebooks em língua estrangeira e idioma português.
  url.searchParams.set('rh', 'n:827235031,p_n_feature_browse-bin:831446031');
  url.searchParams.set('field-publisher', edicao.editoraAmazon ?? edicao.editora);
  if (edicao.autorPesquisa) url.searchParams.set('field-author', edicao.autorPesquisa);
  return url.toString();
}
---

<div data-catalogo-editoras>
  <p>
    Estas {editoras.length} editoras e chancelas têm pelo menos uma edição Kindle em português de Portugal.
    Carrega no nome para pesquisar o catálogo na Amazon.es ou no título para abrir diretamente a edição Kindle desse livro.
  </p>
  <div hidden data-painel-filtro class="not-prose my-5">
    <label for="filtrar-editoras" class="block text-sm font-semibold text-marinho-800">Procurar editora, livro, autor ou tradutor nesta lista</label>
    <input type="search" id="filtrar-editoras" class="mt-2 w-full rounded-lg border border-marinho-300 bg-white px-3 py-2 text-marinho-900" aria-controls="tabela-editoras" />
    <p data-contagem role="status" class="mt-1 text-sm text-marinho-600"></p>
  </div>
  <table id="tabela-editoras">
    <caption class="sr-only">Editoras com edições em português de Portugal na Kindle Store da Amazon.es</caption>
    <thead><tr><th scope="col">Pesquisar por editora</th><th scope="col">Abrir o livro na Amazon.es</th></tr></thead>
    <tbody>
      {editoras.map((edicao) => (
        <tr>
          <th scope="row" class="align-top text-left">
            <LinkAmazon href={pesquisaKindle(edicao)}>{edicao.editora}</LinkAmazon>
            {edicao.autorPesquisa && <small class="block font-normal">Com o filtro de autor {edicao.autorPesquisa}</small>}
          </th>
          <td class="align-top">
            <LinkAmazon href={`https://www.amazon.es/dp/${edicao.asin}`}>(<cite>{edicao.titulo}</cite>)</LinkAmazon> · {edicao.autor}
            {edicao.tradutor && <span> · Tradução de {edicao.tradutor}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  #tabela-editoras tbody th {
    background-color: #edf3f7;
    color: #172c3f;
  }
  #tabela-editoras tbody th :global(a) {
    color: #123858;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.18em;
  }
  #tabela-editoras tbody th :global(a:visited) { color: #4a3162; }
  #tabela-editoras tbody th :global(a:hover) { color: #0e2840; }
  #tabela-editoras tbody th :global(a:focus-visible) {
    outline: 2px solid #15557a;
    outline-offset: 3px;
  }
</style>

<script>
  const catalogo = document.querySelector('[data-catalogo-editoras]');
  const campo = catalogo?.querySelector('input');
  const painel = catalogo?.querySelector<HTMLElement>('[data-painel-filtro]');
  const contagem = catalogo?.querySelector('[data-contagem]');
  if (campo && painel && contagem && catalogo) {
    const normalizar = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLocaleLowerCase('pt').replace(/[’']/g, ' ').trim();
    const linhas = Array.from(catalogo.querySelectorAll('tbody tr'), linha => ({
      linha, texto: normalizar(linha.textContent ?? ''),
    }));
    const filtrar = () => {
      const termos = normalizar(campo.value).split(/\s+/).filter(Boolean);
      let visiveis = 0;
      for (const { linha, texto } of linhas) {
        linha.toggleAttribute('hidden', !termos.every(termo => texto.includes(termo)));
        if (!linha.hasAttribute('hidden')) visiveis++;
      }
      contagem.textContent = termos.length ? `${visiveis} de ${linhas.length} editoras e chancelas` : '';
    };
    campo.addEventListener('input', filtrar);
    filtrar();
    painel.hidden = false;
  }
</script>
