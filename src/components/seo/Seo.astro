---
import { SITE } from '@lib/site';
import { caminhoPublico } from '@lib/urls';

interface Props {
  titulo: string;
  descricao: string;
  canonical?: string;
  imagem?: string;
  /** Texto alternativo da imagem de partilha (og:image:alt). */
  imagemAlt?: string;
  tipo?: 'website' | 'article';
  noindex?: boolean;
  dataPublicacao?: Date;
  dataRevisao?: Date;
  autor?: string;
}

const {
  titulo,
  descricao,
  canonical,
  imagem = '/og/default.png',
  imagemAlt,
  tipo = 'website',
  noindex = false,
  dataPublicacao,
  dataRevisao,
  autor,
} = Astro.props;

const url = canonical ?? new URL(caminhoPublico(Astro.url.pathname), SITE.url).toString();
const imagemAbsoluta = new URL(imagem, SITE.url).toString();
// As imagens de /og/ têm 1200×630; as outras (heros, capas) têm medidas próprias.
const imagemOg = imagem.startsWith('/og/');
const textoImagem =
  imagemAlt ?? (imagem === '/og/default.png' ? `${SITE.nome}: ${SITE.tagline}` : titulo);

// O Google corta os títulos a partir de ~60 caracteres. A marca só entra
// no fim quando cabe; os títulos longos ficam sem ela para não serem cortados.
const LIMITE_TITULO = 60;
const comMarca = `${titulo} · ${SITE.nome}`;
const tituloCompleto =
  titulo.startsWith(SITE.nome) || comMarca.length > LIMITE_TITULO ? titulo : comMarca;
---

<title>{tituloCompleto}</title>
<meta name="description" content={descricao} />
<link rel="canonical" href={url} />
<link rel="alternate" hreflang="pt-PT" href={url} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={tipo} />
<meta property="og:site_name" content={SITE.nome} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={url} />
<meta property="og:locale" content="pt_PT" />
<meta property="og:image" content={imagemAbsoluta} />
{imagemOg && <meta property="og:image:width" content="1200" />}
{imagemOg && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={textoImagem} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={imagemAbsoluta} />
<meta name="twitter:image:alt" content={textoImagem} />

{tipo === 'article' && dataPublicacao && (
  <meta property="article:published_time" content={dataPublicacao.toISOString()} />
)}
{tipo === 'article' && dataRevisao && (
  <meta property="article:modified_time" content={dataRevisao.toISOString()} />
)}
{tipo === 'article' && autor && <meta property="article:author" content={autor} />}
