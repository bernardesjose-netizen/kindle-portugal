# Amazon Associates — Tracking IDs.
# Amazon.es (a loja principal para tráfego PT): a tag deste site já vem no
# código (portukcom_site-21). Só preencher para a mudar sem tocar no código.
# As antigas PUBLIC_AMAZON_TAG_ES e PUBLIC_AMAZON_TAG já não se aplicam à amazon.es.
PUBLIC_AMAZON_TAG_SITE=

# Outros marketplaces.
PUBLIC_AMAZON_TAG_COM=
PUBLIC_AMAZON_TAG_UK=
PUBLIC_AMAZON_TAG_DE=
PUBLIC_AMAZON_TAG_FR=
PUBLIC_AMAZON_TAG_IT=

# Reserva para os marketplaces acima sem tag própria (não se aplica à amazon.es).
PUBLIC_AMAZON_TAG=

# URL canónico do site (sem barra final)
PUBLIC_SITE_URL=https://kindleportugal.com

# Email de contacto público (mostrado no footer e página de contacto)
PUBLIC_CONTACT_EMAIL=ola@kindleportugal.com

# Analytics (opcional — Plausible)
# PUBLIC_PLAUSIBLE_DOMAIN=kindleportugal.com
